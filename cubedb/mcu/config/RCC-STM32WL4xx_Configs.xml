<?xml version="1.0" encoding="ISO-8859-1" standalone="no"?>
<IP xmlns="http://mcd.rou.st.com/modules.php?name=mcu" xmlns:ns0="http://www.w3.org/2001/XMLSchema-instance" DBVersion="V4.0" Name="RCC" Version="STM32Cube_FW_WL4_V0.4.0" ns0:schemaLocation="http://mcd.rou.st.com/modules.php?name=mcu ../../../../../../../doc/V4/Development/Specifications/db/IP_Configs.xsd">
 	<RefConfig Comment="Configure LSE Drive Capability#n#t*#tWarning : Only applied when the LSE is disabled." Name="RCC_LSEDRIVE_CONFIG">
        <IFCondition Expression="LSE_Drive_Capability=RCC_LSEDRIVE_MEDIUMHIGH | LSE_Drive_Capability=RCC_LSEDRIVE_MEDIUMLOW | LSE_Drive_Capability=RCC_LSEDRIVE_HIGH">
            <CallLibMethod Name="__HAL_RCC_LSEDRIVE_CONFIG" ReturnHAL="false">
                <MethodArg Name="__RCC_LSEDRIVE__" ParameterName="LSE_Drive_Capability"/>
            </CallLibMethod>
        </IFCondition>
    </RefConfig>
    <RefConfig Comment="Configure the main internal regulator output voltage" Name="RCC_ConfigVoltageScaling">
        <CallLibMethod Name="HAL_PWREx_ControlVoltageScaling">
            <MethodArg Name="VoltageScaling" ParameterName="PWR_Regulator_Voltage_Scale"/>
        </CallLibMethod>
    </RefConfig>
    <RefConfig Comment="Initializes the RCC Oscillators according to the specified parameters#n#t*  in the RCC_OscInitTypeDef structure." Name="RCC_OSCConfig">
        <CallLibMethod Name="HAL_RCC_OscConfig">
            <MethodArg Name="HSEState"            ParameterName="HSEStateARG"/>
            <MethodArg Name="LSEState"			  ParameterName="LSEStateARG"/>
            <MethodArg Name="LSI1State" 			  ParameterName="LSI1StateARG"/>
            <MethodArg Name="LSI2State" 			  ParameterName="LSI2StateARG"/>
            <MethodArg Name="HSI64State" 			  ParameterName="HSIStateARG"/>
            <MethodArg Name="LSEBYPASSState" 	  ParameterName="LSEBYPASSStateARG"/>
        </CallLibMethod>
    </RefConfig>
	
    <RefConfig Comment="Configure the SYSCLKSource and SYSCLKDivider" Name="RCC_ClockConfig">
        <CallLibMethod Name="HAL_RCC_ClockConfig">
            <MethodArg Name="SYSCLKSource"   ParameterName="SYSCLKSourceARG"/>
            <MethodArg Name="SYSCLKDivider"  ParameterName="SYSCLKDividerARG"/>
        </CallLibMethod>
    </RefConfig>

    <RefConfig Comment="Initializes the peripherals clock" Name="RCC_PeriphClockConfig">
        <CallLibMethod Name="HAL_RCCEx_PeriphCLKConfig">
            <MethodArg Name="PeriphClockSelection" ParameterName="PeriphClockSelectionARG"/>
            <MethodArg Name="Spi3ClockSelection" ParameterName="Spi3ClockSelectionARG"/>
            <MethodArg Name="Spi1ClockSelection" ParameterName="Spi1ClockSelectionARG"/>
            <MethodArg Name="Lptim1ClockSelection" ParameterName="Lptim1ClockSelectionARG"/>
            <MethodArg Name="Lptim2ClockSelection" ParameterName="Lptim2ClockSelectionARG"/>
            <MethodArg Name="Usart1ClockSelection" ParameterName="Usart1ClockSelectionARG"/>
            <MethodArg Name="Usart2ClockSelection" ParameterName="Usart2ClockSelectionARG"/>
            <MethodArg Name="Usart3ClockSelection" ParameterName="Usart3ClockSelectionARG"/>
            <MethodArg Name="Adc1Dac2ClockSelection" ParameterName="Adc1Dac2ClockSelectionARG"/>
            <MethodArg Name="Dac2SHClockSelection" ParameterName="Dac2SHClockSelectionARG"/>
            <MethodArg Name="RngClockSelection" ParameterName="RngClockSelectionARG"/>
            <MethodArg Name="I2c1ClockSelection" ParameterName="I2c1ClockSelectionARG"/>
            <MethodArg Name="I2c2ClockSelection" ParameterName="I2c2ClockSelectionARG"/>
            <MethodArg Name="SystickClockSelection" ParameterName=""/>
            <MethodArg Name="RTCClockSelection" ParameterName="RTCClockSelectionARG"/>
            <MethodArg Name="LcdLcsSubgLpawurClockSelection" ParameterName="LcdLcsSubgLpawurClockSelectionARG"/>
            <MethodArg Name="Lpuart1ClockSelection" ParameterName="LPUART1ClockSelectionARG"/>
        </CallLibMethod>
    </RefConfig>
    
    <RefConfig Comment="Initializes the peripherals clock" Name="RCC_CommonPeriphClockConfig">
        <CallLibMethod Name="HAL_RCCEx_PeriphCLKConfig">
            <MethodArg Name="PeriphClockSelection" ParameterName="C_PeriphClockSelectionARG"/>
            <MethodArg Name="Spi3ClockSelection" ParameterName=""/>
            <MethodArg Name="Spi1ClockSelection" ParameterName=""/>
            <MethodArg Name="Lptim1ClockSelection" ParameterName=""/>
            <MethodArg Name="Lptim2ClockSelection" ParameterName=""/>
            <MethodArg Name="Usart1ClockSelection" ParameterName=""/>
            <MethodArg Name="Usart2ClockSelection" ParameterName=""/>
            <MethodArg Name="Usart3ClockSelection" ParameterName=""/>
            <MethodArg Name="Adc1Dac2ClockSelection" ParameterName=""/>
            <MethodArg Name="Dac2SHClockSelection" ParameterName=""/>
            <MethodArg Name="RngClockSelection" ParameterName=""/>
            <MethodArg Name="I2c1ClockSelection" ParameterName=""/>
            <MethodArg Name="I2c2ClockSelection" ParameterName=""/>
            <MethodArg Name="SystickClockSelection" ParameterName="SystickClockSelectionARG"/>
            <MethodArg Name="RTCClockSelection" ParameterName=""/>
            <MethodArg Name="LcdLcsSubgLpawurClockSelection" ParameterName=""/>
            <MethodArg Name="Lpuart1ClockSelection" ParameterName=""/>
        </CallLibMethod>
    <IFCondition Expression="CLKSPMSKRM">
        <CallLibMethod Name="__HAL_RCC_KRM_RATE_MULTIPLIER_CONFIG" ReturnHAL="false">
            <MethodArg Name="__KRM_VALUE__"   ParameterName="krmRootDivider"/>
        </CallLibMethod>
        <CallLibMethod Name="__HAL_RCC_KRM_ENABLE" ReturnHAL="false">
        </CallLibMethod>
    </IFCondition>
    <IFCondition Expression="SMPSDIVCLK">
        <CallLibMethod Name="__HAL_RCC_SMPS_DIV_CONFIG" ReturnHAL="false">
            <MethodArg Name="__SMPSCLKDIV__"   ParameterName="smpsdivRootDivider"/>
        </CallLibMethod>
    </IFCondition>
    </RefConfig>
   
    <RefConfig Name="RCC_LSCOConfig">
        <CallLibMethod Name="HAL_RCC_LSCOConfig" ReturnHAL="false">
            <MethodArg Name="RCC_LSCOSource" ParameterName="LSCOSource1ARG"/>           
