<?xml version="1.0" encoding="utf-8" standalone="no"?>
<IP xmlns="http://mcd.rou.st.com/modules.php?name=mcu"
    DBVersion="V4.0"
    Name="RCC"
    Version="STM32Cube_FW_WL4_V0.2.0"
    IncludeFile="stm32wl4xx_ll_rcc.h;stm32wl4xx_ll_bus.h;stm32wl4xx_ll_system.h;stm32wl4xx_ll_cortex.h;stm32wl4xx_ll_utils.h;stm32wl4xx_ll_pwr.h;stm32wl4xx_ll_dma.h;stm32wl4xx_ll_gpio.h" 
    xmlns:ns0="http://www.w3.org/2001/XMLSchema-instance" ns0:schemaLocation="http://mcd.rou.st.com/modules.php?name=mcu ../../../../../../../../doc/V4/Development/Specifications/db/IP_Configs.xsd">
    <RefConfig Name="RCC_OSCConfig">      
       
        <IFCondition Expression ="LSIUsed=1 &amp; LSI1">
            <CallLibMethod Name="LL_RCC_LSI1_Enable"/>
    
            <CallLibMethod Name="" Type="HardCode">
                <HardCode Text="#n#t /* Wait till LSI is ready */#n#twhile(LL_RCC_LSI1_IsReady() != 1)#n#t{#n#t}#n"/>
            </CallLibMethod>
        </IFCondition>
        <IFCondition Expression ="LSIUsed=1 &amp; LSI2">
            <CallLibMethod Name="LL_RCC_LSI2_Enable"/>
    
            <CallLibMethod Name="" Type="HardCode">
                <HardCode Text="#n#t /* Wait till LSI is ready */#n#twhile(LL_RCC_LSI2_IsReady() != 1)#n#t{#n#t}#n"/>
            </CallLibMethod>
        </IFCondition>

        <IFCondition Expression ="((LSEOscillator|LSEByPass) &amp; LSEUsed=1)">
            <CallLibMethod Name="" Type="HardCode">
                <HardCode Text="#tLL_PWR_SetNoPullB(LL_PWR_GPIO_BIT_12 | LL_PWR_GPIO_BIT_13);"/>
            </CallLibMethod>
            <CallLibMethod Name="LL_RCC_LSE_SetDriveCapability">
                <MethodArg Name="LSEDrive" ParameterName="LSE_Drive_Capability"/>
            </CallLibMethod>       
        </IFCondition>
           
        <IFCondition Expression ="LSEUsed=1">
            <CallLibMethod Name="" Type="HardCode">
                <HardCode Text="#n#t /* Enable the LSE */ "/>
            </CallLibMethod>
            <IFCondition Expression ="LSEOscillator">
                <CallLibMethod Name="LL_RCC_LSE_Enable"/>
            </IFCondition>
            <IFCondition Expression ="LSEByPass">
                <CallLibMethod Name="LL_RCC_LSE_EnableBypass"/>
            </IFCondition>
            <IFCondition Expression ="LSEOscillator|LSEByPass">
                <CallLibMethod Name="" Type="HardCode">
                    <HardCode Text="#n#t /* Wait till LSE is ready */#n#twhile(LL_RCC_LSE_IsReady() != 1)#n#t{#n#t}#n"/>
                </CallLibMethod>
            </IFCondition>
            <IFCondition Expression ="(LSEOscillator|LSEByPass)&amp;(((MRSUBG_Used|LPAWUR_Used|LCD_Used|LCSC_Used) &amp; LOWSourceLSE)|(LSCOConfig &amp; LSCOSSourceLSE)|(LPTIM1_Used &amp; LPTIM1SourceLSE)|(LPTIM2_Used &amp; LPTIM2SourceLSE)|(USART1_Used &amp; USART1SourceLSE)|(USART2_Used &amp; USART2SourceLSE)|(USART3_Used &amp; USART3SourceLSE)|(LPUART1_Used &amp; LPUART1SourceLSE)|SYSTICKCLKSOURCE_LSESYS)">
                <CallLibMethod Name="LL_RCC_LSESYS_Enable"/>
                <CallLibMethod Name="" Type="HardCode">
                    <HardCode Text="#n#t /* Wait till LSE is ready */#n#twhile(LL_RCC_LSESYS_IsReady() != 1)#n#t{#n#t}#n"/>
                </CallLibMethod>
            </IFCondition>
        </IFCondition>

        <IFCondition Expression ="(HSEOscillator &amp; HSEUsed=1)|(HSEOscillator &amp; RCCLSCOSOURCEPLL64)">
            <CallLibMethod Name="" Type="HardCode">
                <HardCode Text="#n#t /* Set HSE Capacitor Tuning */ "/>
            </CallLibMethod>
            <CallLibMethod Name="LL_RCC_HSE_SetCapacitorTuning">
                <MethodArg Name="Value" ParameterName="HSE_Capacitor_TuningArg"/>
            </CallLibMethod>  
            <CallLibMethod Name="" Type="HardCode">
                <HardCode Text="#n#t /* Set HSE startup Current */#n LL_RCC_HSE_SetStartupCurrent(0); "/>
            </CallLibMethod>  
            <CallLibMethod Name="" Type="HardCode">
                <HardCode Text="#n#t /*  Set HSE Amplitude Threshold */#n LL_RCC_HSE_SetAmplitudeThreshold(0); "/>
            </CallLibMethod>   
    
            <CallLibMethod Name="" Type="HardCode">
                <HardCode Text="#n#t /* Set HSE Current Control */ "/>
            </CallLibMethod>
             <CallLibMethod Name="LL_RCC_HSE_SetCurrentControl">
                <MethodArg Name="Value" ParameterName="HSE_current_control"/>
            </CallLibMethod>    
        </IFCondition>
        <IFCondition Expression ="HSEUsed=1">
        
            <CallLibMethod Name="" Type="HardCode">
                <HardCode Text="#n#t /* Enable the HSE */"/>
            </CallLibMethod>
            <CallLibMethod Name="LL_RCC_HSE_Enable"/>
    
            <CallLibMethod Name="" Type="HardCode">
                <HardCode Text="#n#t /* Wait till HSE is ready */#n#twhile(LL_RCC_HSE_IsReady() != 1)#n#t{#n#t}#n"/>
            </CallLibMethod>
        </IFCondition>

        <!--IFCondition Expression ="HSIUsed=1">
            <CallLibMethod Name="LL_RCC_HSI64_SetCalibTrimming">
                <MethodArg Name="Value" ParameterName="HSICalibrationValue"/>
            </CallLibMethod>
        </IFCondition-->
        
        <IFCondition Expression ="1=1">
            <CallLibMethod Name="LL_FLASH_SetLatency">
                <MethodArg Name="Latency" ParameterName="FLatency"/>
            </CallLibMethod>
        </IFCondition>
     <!--   <IFCondition Expression ="FLatency=FLASH_WAIT_STATES_0">
            <CallLibMethod Name="" Type="HardCode">
                <HardCode Text="#twhile(LL_FLASH_GetLatency()!= LL_FLASH_LATENCY_0)#n#t{#n#t}#n"/>
            </CallLibMethod>
        </IFCondition>
        <IFCondition Expression ="FLatency=FLASH_WAIT_STATES_1">
            <CallLibMethod Name="" Type="HardCode">
                <HardCode Text="#twhile(LL_FLASH_GetLatency()!= LL_FLASH_LATENCY_1)#n#t{#n#t}#n"/>
            </CallLibMethod>
        </IFCondition> -->

        <IFCondition Expression ="SysSourceRC64 &amp; RCCLSCOSOURCEPLL64"> 
            <CallLibMethod Name="" Type="HardCode">
                <HardCode Text="#n#t /* Enable the HSIPLL*/"/>
            </CallLibMethod>
            <CallLibMethod Name="LL_RCC_HSIPLL_Enable"/>
    
            <CallLibMethod Name="" Type="HardCode">
                <HardCode Text="#n#t /* Wait till HSIPLL is ready */#n#twhile(LL_RCC_HSIPLL_IsReady() != 1)#n#t{#n#t}#n"/>
            </CallLibMethod>
        </IFCondition>
        <IFCondition Expression ="HSIUsed=1"> 
            <CallLibMethod Name="" Type="HardCode">
                <HardCode Text="#n#t /* Enable the HSI*/"/>
            </CallLibMethod>
            <CallLibMethod Name="LL_RCC_HSI64_Enable"/>
    
            <CallLibMethod Name="" Type="HardCode">
                <HardCode Text="#n#t /* Wait till HSI is ready */#n#twhile(LL_RCC_HSI64_IsReady() != 1U);#n"/>
            </CallLibMethod>
        </IFCondition>
        <!--Clock source activation-->
        
        <IFCondition Expression ="HSEOscillator">
            <CallLibMethod Name="LL_RCC_HSE_SetPrescaler">
                <MethodArg Name="HSEPrescaler" ParameterName="RCC_HSEDiv"/>
            </CallLibMethod>            
        </IFCondition>   
        <IFCondition Expression ="(SysSourceHSE &amp; HSE_DIV1) | (SysSourceRC64 &amp; RCCLSCOSOURCEPLL64)">
            <CallLibMethod Name="LL_RCC_SetSysClkSource">
                <MethodArg Name="Source" ParameterName="ROOTClkSource"/>
            </CallLibMethod>
        </IFCondition>   
        <IFCondition Expression ="SysSourceHSE &amp; HSE_DIV3">
            <CallLibMethod Name="" Type="HardCode">
                <HardCode Text="#tLL_RCC_SetSysClkSource(LL_RCC_SYS_CLKSOURCE_HSE_DIV3);"/>
            </CallLibMethod>
        </IFCondition>   
        <IFCondition Expression ="SysSourceRC64 &amp; RCCLSCOSOURCEHSI">
            <CallLibMethod Name="" Type="HardCode">
                <HardCode Text="#tLL_RCC_SetSysClkSource(LL_RCC_SYS_CLKSOURCE_HSI64);"/>
            </CallLibMethod>
        </IFCondition>
			
        <IFCondition Expression ="1=1">
            <CallLibMethod Name="LL_RCC_SetSysclkDivider">
                <MethodArg Name="SYSCLKPrescaler" ParameterName="SysCLKDivider"/>
            </CallLibMethod>            
        </IFCondition>   
           
        <IFCondition Expression ="1=1">
            <CallLibMethod Name="" Type="HardCode">
                <HardCode Text="#n#t  /* Update the SystemCoreClock global variable */"/>
            </CallLibMethod>
            <CallLibMethod Name="LL_SetSystemCoreClock">
                <MethodArg Name="Value" ParameterName="CLKSYSFreq_VALUE"/>
            </CallLibMethod>            
        </IFCondition>   
        <IFCondition Expression ="1=1">
            <CallLibMethod Name="" Type="HardCode">
                <HardCode Text="#n#t /* Configure the source of time base considering new system clocks settings*/ "/>
            </CallLibMethod>
            <CallLibMethod Name="LL_Init1msTick">
                <MethodArg Name="Value" ParameterName="CLKSYSFreq_VALUE"/>
            </CallLibMethod>            
        </IFCondition>
    </RefConfig>

    <RefConfig Name="RCC_LSCOConfig">
         <IFCondition Expression ="LSCOConfig">
            <CallLibMethod Name="LL_RCC_LSCO_SetSource">
                <MethodArg Name="LSCOxSource" ParameterName="LSCOSource1"/>
            </CallLibMethod>
        </IFCondition>
    </RefConfig>

    <RefConfig Name="RCC_MCO1Config">
        <!--MCO clock source -->
         <IFCondition Expression ="MCOConfig">
            <CallLibMethod Name="LL_RCC_ConfigMCO">
                <MethodArg Name="MCOPrescaler" ParameterName="RCC_MCODiv"/>
                <MethodArg Name="MCOSource" ParameterName="RCC_MCO1Source"/>
            </CallLibMethod>
        </IFCondition>
    </RefConfig>
    
    <RefConfig Name="RCC_CommonPeriphClockConfig">
         <CallLibMethod Name="LL_RCC_SetSystickClockSource">
                    <MethodArg Name="CPUSource" ParameterName="CLKCPUMult"/>
        </CallLibMethod>
        <IFCondition Expression ="SMPSDIVCLK">
                <CallLibMethod Name="LL_RCC_SetSMPSDivider">
                    <MethodArg Name="SMPSxSource" ParameterName="smpsdivRootDivider"/>
                </CallLibMethod>
        </IFCondition>        
        <IFCondition Expression ="CLKSPMSKRM">
                <CallLibMethod Name="" Type="HardCode">
                  <HardCode Text="#n#t/* Enable the KRM*/"/>
                </CallLibMethod>
                <CallLibMethod Name="LL_RCC_KRM_SetRateMultiplier">
                    <MethodArg Name="Prescaler" ParameterName="krmRootDivider"/>
                </CallLibMethod>
                <CallLibMethod Name="LL_RCC_KRM_Enable"/>
                 
        </IFCondition>
    </RefConfig>

    <RefConfig Name="RCC_PeriphClockConfig">
        
        <IFCondition Expression ="I2C1_Used">
            <CallLibMethod Name="LL_RCC_SetI2CClockSource">
                <MethodArg Name="I2CxSource" ParameterName="I2C1ClockSelection"/>
            </CallLibMethod>
        </IFCondition>         
        <IFCondition Expression ="I2C2_Used">
            <CallLibMethod Name="LL_RCC_SetI2CClockSource">
                <MethodArg Name="I2CxSource" ParameterName="I2C2ClockSelection"/>
            </CallLibMethod>
        </IFCondition>         
        <IFCondition Expression ="SPI1_Used">
            <CallLibMethod Name="LL_RCC_SetSPI1ClockSource">
                <MethodArg Name="spi1xSource" ParameterName="SPI1ClockSelection"/>
            </CallLibMethod>
        </IFCondition>         
        <IFCondition Expression ="ADC1_Used|DAC2_Used">
            <CallLibMethod Name="LL_RCC_SetADCDACClockSource">
                <MethodArg Name="ADC1DAC2xSource" ParameterName="ADC1DAC2ClockSelection"/>
            </CallLibMethod>
        </IFCondition>         
        <IFCondition Expression ="DAC2_Used">
            <CallLibMethod Name="LL_RCC_SetDAC2SHClockSource">
                <MethodArg Name="DAC2xSource" ParameterName="DAC2ClockSelection"/>
            </CallLibMethod>
        </IFCondition>
        <IFCondition Expression ="LPTIM1_Used">
            <CallLibMethod Name="LL_RCC_SetLPTIMClockSource">
                <MethodArg Name="LPTIMxSource" ParameterName="LPTIM1ClockSelection"/>
            </CallLibMethod>
        </IFCondition>
        <IFCondition Expression ="RTC_Used">
            <CallLibMethod Name="LL_RCC_SetRTCClockSource">
                <MethodArg Name="RTCxSource" ParameterName="RTCClockSelection"/>
            </CallLibMethod>
        </IFCondition>
        <IFCondition Expression ="LPTIM2_Used">
            <CallLibMethod Name="LL_RCC_SetLPTIMClockSource">
                <MethodArg Name="LPTIMxSource" ParameterName="LPTIM2ClockSelection"/>
            </CallLibMethod>
        </IFCondition>        
        <IFCondition Expression ="USART1_Used">
            <CallLibMethod Name="LL_RCC_SetUSARTClockSource">
                <MethodArg Name="USARTxSource" ParameterName="USART1ClockSelection"/>
            </CallLibMethod>
        </IFCondition>        
        <IFCondition Expression ="USART2_Used">
            <CallLibMethod Name="LL_RCC_SetUSARTClockSource">
                <MethodArg Name="USARTxSource" ParameterName="USART2ClockSelection"/>
            </CallLibMethod>
        </IFCondition>        
        <IFCondition Expression ="USART3_Used">
            <CallLibMethod Name="LL_RCC_SetUSARTClockSource">
                <MethodArg Name="USARTxSource" ParameterName="USART3ClockSelection"/>
            </CallLibMethod>
        </IFCondition>        
        <IFCondition Expression ="RNG_Used">
            <CallLibMethod Name="LL_RCC_SetRNGClockSource">
                <MethodArg Name="RNGxSource" ParameterName="RNGClockSelection"/>
            </CallLibMethod>
        </IFCondition>
        <IFCondition Expression ="SPI3_Used|I2S3_Used">
            <CallLibMethod Name="LL_RCC_SetSPI3I2SClockSource">
                <MethodArg Name="spi3xSource" ParameterName="SPI3ClockSelection"/>
            </CallLibMethod>
        </IFCondition>
        <IFCondition Expression ="LPUART1_Used|LPUART_Used">
            <CallLibMethod Name="LL_RCC_SetLPUARTClockSource">
                <MethodArg Name="LPUARTxSource" ParameterName="LPUART1ClockSelection"/>
            </CallLibMethod>
        </IFCondition>

        <IFCondition Expression ="MRSUBG_Used|LPAWUR_Used|LCD_Used|LCSC_Used">
            <CallLibMethod Name="LL_RCC_SLOWCLKSEL_SetSource">
                <MethodArg Name="SLOWxSource" ParameterName="LowSpeedClockSelection"/>
            </CallLibMethod>
        </IFCondition>
    </RefConfig>

    <LibMethod Comment="" Name="LL_FLASH_SetLatency">
        <Argument AddressOf="false" GenericType="simple" Name="Latency"/>
    </LibMethod>
    <LibMethod Comment="" Name="LL_RCC_LSE_SetDriveCapability">
        <Argument AddressOf="false" GenericType="simple" Name="LSEDrive"/>
    </LibMethod>
           
    
    <LibMethod Comment="" Name="LL_RCC_HSIPLL_Enable"/>

    <LibMethod Comment="" Name="LL_RCC_HSI64_Enable"/>

    
    
    <LibMethod Comment="" Name="LL_RCC_HSE_Enable"/>

    <LibMethod Comment="" Name="LL_RCC_LSE_Enable"/>

