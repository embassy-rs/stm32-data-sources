    <!-- ************************************* Modes ********************************************* -->
    <ModeLogicOperator Name="OR">
        <Mode Name="XSPI1_Mode" UserName="Mode">           
            <ModeLogicOperator Name="XOR">
                <Mode Name="single_mode" UserName="Single SPI">
                    <SignalLogicalOp Name="AND">
                        <Signal Name="CLK"/>
                    </SignalLogicalOp>
                    <Semaphore>Sem_$IpInstance_Single</Semaphore>
                </Mode>
                <Mode Name="dual_mode" UserName="Dual SPI">
                    <SignalLogicalOp Name="AND">
                        <Signal Name="CLK"/>
                    </SignalLogicalOp>
                    <Semaphore>Sem_$IpInstance_Dual</Semaphore>
                </Mode>
                <Mode Name="quad_mode" UserName="Quad SPI">
                    <SignalLogicalOp Name="AND">
                        <Signal Name="CLK"/>
                    </SignalLogicalOp>
                    <Semaphore>Sem_$IpInstance_Quad</Semaphore>
                </Mode>
                <Mode Name="dual_single_mode" UserName="Dual-Single SPI">
                    <SignalLogicalOp Name="AND">
                        <Signal Name="CLK"/>
                    </SignalLogicalOp>
                    <Semaphore>Sem_$IpInstance_DualSingle</Semaphore>
                </Mode>
                <Mode Name="dual_dual_mode" UserName="Dual-Dual SPI">
                    <SignalLogicalOp Name="AND">
                        <Signal Name="CLK"/>
                    </SignalLogicalOp>
                    <Semaphore>Sem_$IpInstance_DualDual</Semaphore>
                </Mode>
                <Mode Name="dual_quad_mode" UserName="Dual-Quad SPI">
				<Condition Diagnostic="Only available for WL41/3" Expression="!STM32WLx0"/>
                    <SignalLogicalOp Name="AND">
                        <Signal Name="CLK"/>
                    </SignalLogicalOp>
                    <Semaphore>Sem_$IpInstance_DualQuad</Semaphore>
                </Mode>
                <Mode Name="octo_mode" UserName="Octo SPI">
				<Condition Diagnostic="Only available for WL41/3" Expression="!STM32WLx0"/>
                    <SignalLogicalOp Name="AND">
                        <Signal Name="CLK"/>
                    </SignalLogicalOp>
                    <Semaphore>Sem_$IpInstance_Octo</Semaphore>
                </Mode>
                <Mode Name="octods_mode" UserName="Octo SPI with Data Strobe">
				<Condition Diagnostic="Only available for WL41/3" Expression="!STM32WLx0"/>
                    <SignalLogicalOp Name="AND">
                        <Signal Name="DQS"/>
                        <Signal Name="CLK"/>
                    </SignalLogicalOp>
                    <Semaphore>Sem_$IpInstance_OctoDs</Semaphore>
                </Mode>
            </ModeLogicOperator>
        </Mode>

		<Mode Name="XSPI1_NCS" UserName="Chip Select">
		    <Condition Diagnostic="[$IpInstance] 'Mode' has to be set; Supported 'Mode': All" Expression="$IpInstance_Used"/>
                <ModeLogicOperator Name="XOR">
                    <Mode Name="XSPI1_NCS1" UserName="NCS1">
                        <SignalLogicalOp Name="AND">
                            <Signal Name="NCS1"/>
                        </SignalLogicalOp>
                    </Mode>
                    <Mode Name="XSPI1_NCS2" UserName="NCS2">
                        <SignalLogicalOp Name="AND">
                            <Signal Name="NCS2"/>
                        </SignalLogicalOp>
                    </Mode>
                </ModeLogicOperator>
                <Semaphore>Sem_$IpInstance_NCS</Semaphore>
        </Mode>

        <Mode Name="XSPI1_Data" UserName="Data" RemoveDisable="true">
            <ModeLogicOperator Name="XOR">
                <Mode Name="XSPI1_IO[1:0]" UserName="IO[1:0]">
                    <Condition Expression="(Sem_$IpInstance_Single|Sem_$IpInstance_Dual)" Diagnostic=""/>
                    <SignalLogicalOp Name="AND">
                        <Signal Name="IO0"/>
                        <Signal Name="IO1"/>
                    </SignalLogicalOp>
					<Semaphore>Sem_$IpInstance_IO10</Semaphore>
                </Mode>
                <Mode Name="XSPI1_IO[3:0]" UserName="IO[3:0]">
                    <Condition Expression="(Sem_$IpInstance_Quad)" Diagnostic=""/>
                    <SignalLogicalOp Name="AND">
                        <Signal Name="IO0"/>
                        <Signal Name="IO1"/>
                        <Signal Name="IO2"/>
                        <Signal Name="IO3"/>
                    </SignalLogicalOp>
					<Semaphore>Sem_$IpInstance_IO30</Semaphore>
                </Mode>
                <Mode Name="XSPI1_IO[5:4]" UserName="IO[5:4]">
                    <Condition Expression="(Sem_$IpInstance_Single|Sem_$IpInstance_Dual)" Diagnostic=""/>
                    <SignalLogicalOp Name="AND">
