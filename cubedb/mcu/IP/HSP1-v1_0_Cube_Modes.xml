        <Parameter Name="REGISTERS_LOCK"/> 
        <Parameter Name="SMART_CLOCK_GATING"/>
        <Parameter Name="DIRECT_COMMAND_EVENT_ENABLE"/>  
        -->
    </RefMode>   
    
    <RefMode BaseMode="Hsp_init" Name="Debug" Abstract = "true">
        <!-- Out of scope for SW Pack 1 -->
        <!--
