    <RefMode BaseMode="Hsp_init" Name="Enable" HalMode ="HSP">
        <ConfigForMode>HSP_Init</ConfigForMode>  
        <!--<Parameter Name="Instance"/>--> 
        <!-- HSP Register waiting definition from HAL--> 
        <Parameter Name="global_state"/>
