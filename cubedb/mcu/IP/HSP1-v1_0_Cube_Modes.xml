    <!-- Modes -->
    <ModeLogicOperator Name="OR">       
        <Mode Name="Activate">
            <ModeLogicOperator Name="OR">
                <Mode Name="Enable" UserName="Activate">
                    <SignalLogicalOp Name="AND">
                        <Signal Name="VS_HSP"/>
                    </SignalLogicalOp>
                    <Semaphore>MW_HSP1_MW</Semaphore>
                    <Semaphore>S_HSP_ACTIVATED</Semaphore>
                </Mode>               
            </ModeLogicOperator>            
        </Mode>
        <Mode Name="Debug">
            <ModeLogicOperator Name="OR">
                <Mode Name="Debug" UserName="Debug and Diagnostic">
                    <SignalLogicalOp Name="OR">                                          
                        <Signal Name="SNP0"/>
                        <Signal Name="SNP1"/>
                        <Signal Name="SNP2"/>
                        <Signal Name="SNP3"/>
                        <Signal Name="SNP4"/>
                        <Signal Name="SNP5"/>                        
                    </SignalLogicalOp>
                    <Semaphore>S_HSP_DEBUG</Semaphore>
                </Mode>               
            </ModeLogicOperator>
            <Condition Expression="S_HSP_ACTIVATED" Diagnostic="Not valid while the Activated mode is not checked"/>
        </Mode>       
    </ModeLogicOperator>
	
    <RefSignal Name="VS_HSP" Virtual="true"/>
    <RefSignal Name="VS_HSP_DEBUG" Virtual="true"/>
    <RefSignal Name="VS_HSP_ACC" Virtual="true"/>
    <RefSignal Name="VS_HSP_SEQ" Virtual="true"/>
    <RefSignal Name="VS_HSP_BASIC" Virtual="true"/>
    <RefSignal Name="VS_HSP_ADVANCED" Virtual="true"/>
    <RefSignal Name="VS_HSP_APPLICATION" Virtual="true"/>
    
    <!-- RefSignal for HSP1 -->
    <RefSignal IOMode="AlternateFunctionPushPullUp" Name="SNP0"/>
    <RefSignal IOMode="AlternateFunctionPushPullUp" Name="SNP1"/>
    <RefSignal IOMode="AlternateFunctionPushPullUp" Name="SNP2"/>
    <RefSignal IOMode="AlternateFunctionPushPullUp" Name="SNP3"/>
    <RefSignal IOMode="AlternateFunctionPushPullUp" Name="SNP4"/>
    <RefSignal IOMode="AlternateFunctionPushPullUp" Name="SNP5"/>
    <Semaphore>USE_$IpInstance</Semaphore>
</IP>
