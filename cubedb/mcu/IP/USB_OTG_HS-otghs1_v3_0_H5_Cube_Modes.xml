<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<IP DBVersion="V4.0" 
	IPType="peripheral" 
	Name="USB_OTG_HS" 
	Version="otghs1_v3_0_H5_Cube" 
	xmlns:ns0="http://www.w3.org/2001/XMLSchema-instance" 
	ns0:schemaLocation="http://mcd.rou.st.com/modules.php?name=mcu ../../../../../../../doc/V4/Development/Specifications/db/IP_Modes.xsd" 
	xmlns="http://mcd.rou.st.com/modules.php?name=mcu">
  <About>USB_OTG_HS: Universal Serial Bus On-The-Go High-Speed</About>
	
	<!-- Generic RefParameters for USB High Speed Host & Device Modes -->
	<RefParameter Name="Instance" DefaultValue="USB_OTG_HS" Comment="Instance" Type="" Visible="false"/>
	
	<!-- Virtual Mode Parameter, to define RefParameter in function of RefMode -->
	<RefParameter Comment="" DefaultValue="Int_Phy_Host" Name="VirtualMode" Type="list" Visible="false" >
		<PossibleValue Comment="" Value="Int_Phy_Host"/>
		<PossibleValue Comment="" Value="Int_Phy_Device"/>
		<PossibleValue Comment="" Value="Dual_Role_Device"/>
	</RefParameter>
	
	<!-- Bug356587 -->		
	<!-- Parameters dev_endpoints --> 
	<RefParameter Comment="Device endpoints number" DefaultValue="null" Name="dev_endpoints" Type="List" Group="" Visible="false">	
		<Condition Expression="(VirtualMode = Int_Phy_Host)" Diagnostic=""/>		
	</RefParameter>	
	<!-- Bug356587 -->		
	<RefParameter Comment="Device endpoints number" DefaultValue="9" Name="dev_endpoints" Min="1" Max="9" Type="integer" Group="" Visible="false">				
	</RefParameter>	
	
	<!-- Parameters Host_channels --> 
	<RefParameter Comment="Host Channels" DefaultValue="16" Name="Host_channels"  Min="1" Max="16" Type="integer" Visible="false">	
		<Condition Expression="(VirtualMode = Int_Phy_Host)" Diagnostic=""/>		
	</RefParameter>
	<RefParameter Comment="Host Channels" DefaultValue="null" Name="Host_channels"  Min="1" Max="16" Type="integer" Visible="false">				
	</RefParameter>
	
	<!-- Parameters phy_itface --> 	
	<RefParameter Comment="Physical interface" DefaultValue="HCD_HS_PHY_EMBEDDED" Name="phy_itface_host" Type="List" Group="Host configuration">		
		<PossibleValue Value="HCD_HS_PHY_EMBEDDED" Comment="Internal Phy"/>	
	</RefParameter>
	<RefParameter Comment="Physical interface" DefaultValue="PCD_HS_PHY_EMBEDDED" Name="phy_itface" Type="List" Group="Device configuration">		
		<Condition Expression="(VirtualMode = Dual_Role_Device)" Diagnostic=""/>
		<PossibleValue Value="PCD_HS_PHY_EMBEDDED" Comment="Internal Phy"/>	
	</RefParameter>
	<RefParameter Comment="Physical interface" DefaultValue="PCD_HS_PHY_EMBEDDED" Name="phy_itface" Type="List">		
		<Condition Expression="VirtualMode = Int_Phy_Device" Diagnostic=""/>
		<PossibleValue Value="PCD_HS_PHY_EMBEDDED" Comment="Internal Phy"/>	
	</RefParameter>
	<RefParameter Comment="Physical interface" DefaultValue="HCD_HS_PHY_EMBEDDED" Name="phy_itface" Type="List">		
		<Condition Expression="(VirtualMode = Int_Phy_Host)" Diagnostic=""/>
		<PossibleValue Value="HCD_HS_PHY_EMBEDDED" Comment="Internal Phy"/>	
	</RefParameter>	

	<RefParameter Comment="Physical interface" DefaultValue="USB_OTG_ULPI_PHY" Name="phy_itface" Type="List" Visible="false"/>
	
	<!-- Parameters dma_enable --> 
	<RefParameter Comment="Enable internal IP DMA" DefaultValue="DISABLE" Name="dma_enable" Type="List" Group="Device configuration">
		<Condition Expression="(VirtualMode = Dual_Role_Device)" Diagnostic=""/>
		<PossibleValue Value="ENABLE" Comment="Enabled" Semaphore="SEM_HS_USE_BUFF_WO_ALIGNMENT"/>
		<PossibleValue Value="DISABLE" Comment="Disabled"/>
	</RefParameter>	

	<RefParameter Comment="Enable internal IP DMA" DefaultValue="DISABLE" Name="dma_enable" Type="List">
		<PossibleValue Value="ENABLE" Comment="Enabled" Semaphore="SEM_HS_USE_BUFF_WO_ALIGNMENT"/>
		<PossibleValue Value="DISABLE" Comment="Disabled"/>
	</RefParameter>	

	<RefParameter Comment="Enable internal IP DMA" DefaultValue="DISABLE" Name="dma_enable_host" Type="List" Group="Host configuration">
		<PossibleValue Value="ENABLE" Comment="Enabled" Semaphore="SEM_HS_USE_BUFF_WO_ALIGNMENT"/>
		<PossibleValue Value="DISABLE" Comment="Disabled" Semaphore="SEM_dma_disable"/>
	</RefParameter>	
	
	<!-- Parameters Sof_enable --> 
	<RefParameter Comment="Signal start of frame" DefaultValue="ENABLE" Name="Sof_enable" Type="List" Group="Device configuration">
		<PossibleValue Value="ENABLE" Comment="Enabled"/>
		<Condition Expression="USB_FS_SOF &amp; (VirtualMode = Dual_Role_Device)" Diagnostic=""/>
	</RefParameter>	
	<RefParameter Comment="Signal start of frame" DefaultValue="DISABLE" Name="Sof_enable" Type="List" Group="Device configuration">
		<PossibleValue Value="ENABLE" Comment="Enabled"/>
		<PossibleValue Value="DISABLE" Comment="Disabled"/>
		<Condition Expression="(VirtualMode = Dual_Role_Device)" Diagnostic=""/>
	</RefParameter>
	<RefParameter Comment="Signal start of frame" DefaultValue="ENABLE" Name="Sof_enable_host" Type="List" Group="Host configuration">
		<PossibleValue Value="ENABLE" Comment="Enabled" Semaphore="SEM_Sof_enable_enabled"/>
		<Condition Expression="USB_FS_SOF" Diagnostic=""/>
	</RefParameter>	
	<RefParameter Comment="Signal start of frame" DefaultValue="DISABLE" Name="Sof_enable_host" Type="List" Group="Host configuration">
		<PossibleValue Value="ENABLE" Comment="Enabled" Semaphore="SEM_Sof_enable_enabled"/>
		<PossibleValue Value="DISABLE" Comment="Disabled" Semaphore="SEM_Sof_enable_disabled"/>
	</RefParameter>

	<RefParameter Comment="Signal start of frame" DefaultValue="ENABLE" Name="Sof_enable" Type="List">
		<PossibleValue Value="ENABLE" Comment="Enabled"/>
		<Condition Expression="USB_FS_SOF" Diagnostic=""/>
	</RefParameter>	
	<RefParameter Comment="Signal start of frame" DefaultValue="DISABLE" Name="Sof_enable" Type="List">
		<PossibleValue Value="ENABLE" Comment="Enabled"/>
		<PossibleValue Value="DISABLE" Comment="Disabled"/>
	</RefParameter>
	
	<RefParameter Comment="Link Power Management" DefaultValue="DISABLE" Name="lpm_enable" Type="List" Group="Device configuration" Visible="true">
		<Condition Expression="(VirtualMode = Dual_Role_Device)" Diagnostic=""/>		
		<PossibleValue Value="DISABLE" Comment="Disabled"/>	
		<PossibleValue Value="ENABLE" Comment="Enabled"/>
	</RefParameter>	
	<RefParameter Comment="Link Power Management" DefaultValue="DISABLE" Name="lpm_enable" Type="List" Group="" Visible="true">
		<Condition Expression="(MW_USB_OTG_HS_MW_DEVICE)" Diagnostic=""/>		
		<PossibleValue Value="DISABLE" Comment="Disabled"/>	
		<PossibleValue Value="ENABLE" Comment="Enabled"/>
	</RefParameter>

	<RefParameter Comment="Low power" DefaultValue="DISABLE" Name="low_power_enable" Type="List" Group="Device configuration">
	  <Condition Expression="VirtualMode = Dual_Role_Device" Diagnostic=""/>			
		<PossibleValue Value="ENABLE" Comment="Enabled" Semaphore="$IpInstance_INTERRUPT_WAKEUP_ON"/>
		<PossibleValue Value="DISABLE" Comment="Disabled"/>		
	</RefParameter>
	<RefParameter Comment="Low power" DefaultValue="DISABLE" Name="low_power_enable" Type="List">
	  <Condition Expression="MW_USB_OTG_HS_MW_DEVICE" Diagnostic=""/>			
		<PossibleValue Value="ENABLE" Comment="Enabled" Semaphore="$IpInstance_INTERRUPT_WAKEUP_ON"/>
		<PossibleValue Value="DISABLE" Comment="Disabled"/>		
	</RefParameter>
	<RefParameter Comment="Low power" DefaultValue="DISABLE" Name="low_power_enable" Type="List" Visible="false">
		<Condition Expression="MW_USB_OTG_HS_MW_HOST" Diagnostic=""/>			
		<PossibleValue Value="DISABLE" Comment="Disabled"/>		
	</RefParameter>
	
	<RefParameter Comment="Speed" DefaultValue="USB_OTG_SPEED_HIGH" Name="speed" Type="List" Group="Device configuration">
		<Condition Expression="VirtualMode = Dual_Role_Device" Diagnostic=""/>			
		<PossibleValue Comment="High Speed 480MBit/s" Value="USB_OTG_SPEED_HIGH" />
		<PossibleValue Comment="Full Speed 12MBit/s" Value="USB_OTG_SPEED_HIGH_IN_FULL"/>
		<PossibleValue Comment="Low Speed 1.5MBit/s" Value="USB_OTG_SPEED_FULL" />
	</RefParameter>	
	<RefParameter Comment="Speed" DefaultValue="HCD_SPEED_HIGH" Name="speed" Type="List">	
		<Condition Expression="VirtualMode = Int_Phy_Host" Diagnostic=""/>			
		<PossibleValue Comment="High Speed 480MBit/s" Value="HCD_SPEED_HIGH" />
		<PossibleValue Comment="Full Speed 12MBit/s" Value="USB_OTG_SPEED_HIGH_IN_FULL"/>
		<PossibleValue Comment="Low Speed 1.5MBit/s" Value="USB_OTG_SPEED_FULL" />
	</RefParameter>
	<RefParameter Comment="Speed" DefaultValue="PCD_SPEED_HIGH" Name="speed" Type="List">	
		<Condition Expression="VirtualMode = Int_Phy_Device" Diagnostic=""/>	
		<PossibleValue Comment="High Speed 480MBit/s" Value="PCD_SPEED_HIGH" />
		<PossibleValue Comment="Full Speed High 12MBit/s" Value="PCD_SPEED_HIGH_IN_FULL"/>
		<PossibleValue Comment="Full Speed 1.5MBit/s" Value="PCD_SPEED_FULL" />
	</RefParameter>	

	<RefParameter Comment="Speed" DefaultValue="USB_OTG_SPEED_HIGH" Name="speed_host" Type="List" Group="Host configuration">	
		<PossibleValue Comment="High Speed 480MBit/s" Value="USB_OTG_SPEED_HIGH" Semaphore="SEM_USB_OTG_SPEED_HIGH"/>
		<PossibleValue Comment="Full Speed 12MBit/s" Value="USB_OTG_SPEED_HIGH_IN_FULL" Semaphore="SEM_USB_OTG_SPEED_HIGH_IN_FULL"/>
		<PossibleValue Comment="Low Speed 1.5MBit/s" Value="USB_OTG_SPEED_FULL" Semaphore="SEM_USB_OTG_SPEED_FULL" />
	</RefParameter>	
	
	<RefParameter Comment="Low power" DefaultValue="DISABLE" Name="low_power_enable_host" Type="List" Group="Host configuration" Visible="false">
		<PossibleValue Value="DISABLE" Comment="Disabled"/>		
	</RefParameter>
	<!-- Parameters vbus_sensing_enable --> 
    <RefParameter Comment="VBUS sensing" DefaultValue="ENABLE" Name="vbus_sensing_enable" Type="List" Group="Device configuration">
        <Condition Expression="(VirtualMode = Dual_Role_Device) &amp; VBUS_SENSING_ON_HS" Diagnostic=""/>
		<PossibleValue Value="ENABLE" Comment="Enabled"/>
    </RefParameter>	
    <RefParameter Comment="VBUS sensing" DefaultValue="DISABLE" Name="vbus_sensing_enable" Type="List" Group="Device configuration">
        <Condition Expression="(VirtualMode = Dual_Role_Device) &amp; !VBUS_SENSING_ON_HS" Diagnostic=""/>
        <PossibleValue Value="DISABLE" Comment="Disabled"/>
    </RefParameter>
    <RefParameter Comment="VBUS sensing" DefaultValue="ENABLE" Name="vbus_sensing_enable" Type="List">
        <Condition Expression="(VirtualMode = Int_Phy_Device) &amp; VBUS_SENSING_ON_HS" Diagnostic=""/>
		<PossibleValue Value="ENABLE" Comment="Enabled"/>
    </RefParameter>	
    <RefParameter Comment="VBUS sensing" DefaultValue="DISABLE" Name="vbus_sensing_enable" Type="List">
        <Condition Expression="(VirtualMode = Int_Phy_Device) &amp; !VBUS_SENSING_ON_HS" Diagnostic=""/>
        <PossibleValue Value="DISABLE" Comment="Disabled"/>
    </RefParameter>
    <RefParameter Comment="VBUS sensing" DefaultValue="DISABLE" Name="vbus_sensing_enable" Type="List" Visible="false">		
		<PossibleValue Value="ENABLE" Comment="Enabled"/>
		<PossibleValue Value="DISABLE" Comment="Disabled"/>
	</RefParameter>    
	
	<RefParameter Comment="VBUS sensing" DefaultValue="DISABLE" Name="vbus_sensing_enable_host" Type="List" Visible="false">		
		<PossibleValue Value="ENABLE" Comment="Enabled"/>
		<PossibleValue Value="DISABLE" Comment="Disabled"/>
	</RefParameter>
	
	<!-- Parameters use_dedicated_ep1 --> 
	<RefParameter Comment="Use dedicated end point 1 interrupt" DefaultValue="null" Name="use_dedicated_ep1" Type="List" >
		<Condition Expression="(VirtualMode = Int_Phy_Host)" Diagnostic=""/>
		<PossibleValue Value="DISABLE" Comment="Disabled"/>	
	</RefParameter>	
	<!--  Bug356454 -->
	<RefParameter Comment="Use dedicated end point 1 interrupt" DefaultValue="DISABLE" Name="use_dedicated_ep1" Type="List" Group="Device configuration" >
		<Condition Expression="(VirtualMode = Dual_Role_Device)" Diagnostic=""/>
		<PossibleValue Value="ENABLE" Comment="Enabled" Semaphore="$IpInstance_USE_DEDICATED_EP1_ON"/>
		<PossibleValue Value="DISABLE" Comment="Disabled"/>		
	</RefParameter>
	<RefParameter Comment="Use dedicated end point 1 interrupt" DefaultValue="DISABLE" Name="use_dedicated_ep1" Type="List" >
		<PossibleValue Value="ENABLE" Comment="Enabled" Semaphore="$IpInstance_USE_DEDICATED_EP1_ON"/>
		<PossibleValue Value="DISABLE" Comment="Disabled"/>		
	</RefParameter>
	
	<!-- Parameters use_external_vbus --> 
	<RefParameter Comment="Use external vbus" DefaultValue="DISABLE" Name="use_external_vbus" Type="List">
		<Condition Expression="(VirtualMode = Int_Phy_Host)" Diagnostic=""/>
		<PossibleValue Value="ENABLE" Comment="Enabled"/>	
		<PossibleValue Value="DISABLE" Comment="Disabled"/>			
	</RefParameter>	
	<RefParameter Comment="Use external vbus" DefaultValue="DISABLE" Name="use_external_vbus" Type="List" Visible="false">
		<PossibleValue Value="ENABLE" Comment="Enabled"/>
		<PossibleValue Value="DISABLE" Comment="Disabled"/>		
	</RefParameter>
	
	<RefMode Name="Internal_Phy_Host" HalMode="HCD">
		<ConfigForMode>HCD_Init_HS</ConfigForMode>
		<Parameter Name="VirtualMode">		
			<PossibleValue>Int_Phy_Host</PossibleValue>
		</Parameter>
		<Parameter Name="Sof_enable"/>
		<Parameter Name="Host_channels"/>			
		<Parameter Name="speed"/>		
		<Parameter Name="dma_enable"/>
		<Parameter Name="phy_itface"/>			
		<Parameter Name="low_power_enable"/>	
		<Parameter Name="use_external_vbus"/>	
		<Parameter Name="vbus_sensing_enable"/>			
	</RefMode>
	
	<RefMode Name="Internal_Phy_Device" HalMode="PCD">
		<ConfigForMode>PCD_Init_HS</ConfigForMode>
		<Parameter Name="VirtualMode">		
			<PossibleValue>Int_Phy_Device</PossibleValue>
		</Parameter>
		<Parameter Name="dev_endpoints"/>	
		<Parameter Name="Sof_enable"/>
		<Parameter Name="speed"/>
		<Parameter Name="dma_enable"/>
		<Parameter Name="phy_itface"/>					
		<Parameter Name="low_power_enable"/>
		<Parameter Name="lpm_enable"/>
		<Parameter Name="use_dedicated_ep1"/>	
		<Parameter Name="vbus_sensing_enable"/>	
	</RefMode>

	<RefMode Name="Dual-Role-Device" HalMode="PCD">
		<ConfigForMode>PCD_Init_HS</ConfigForMode>
		<Parameter Name="VirtualMode">		
			<PossibleValue>Dual_Role_Device</PossibleValue>
		</Parameter>
		<Parameter Name="dev_endpoints"/>	
		<Parameter Name="Sof_enable"/>
		<Parameter Name="speed"/>
		<Parameter Name="dma_enable"/>
		<Parameter Name="phy_itface"/>					
		<Parameter Name="low_power_enable"/>
		<Parameter Name="lpm_enable"/>
		<Parameter Name="use_dedicated_ep1"/>	
		<Parameter Name="vbus_sensing_enable"/>	

		<Parameter Name="Sof_enable_host"/>
		<!-- <Parameter Name="Host_channels"/> -->
		<Parameter Name="speed_host"/>
		<Parameter Name="dma_enable_host"/>
		<Parameter Name="phy_itface_host"/>
		<Parameter Name="low_power_enable_host"/>
		<Parameter Name="vbus_sensing_enable_host"/>
	</RefMode>
	
	
	<!-- USB Full Speed in Device mode with SOF -->
	<RefMode Name="Activate_SOF_FS" HalMode="">		
	</RefMode>
	
	<!-- tracker 233865 -->
	<RefMode Name="Activate_VBUS_FS" HalMode="">			
	</RefMode>
	
	<!-- ModeLogicOperator for HS/FS -->
	<ModeLogicOperator Name="OR">	
		<Mode Name="Internal Phy HS">			
			<ModeLogicOperator Name="XOR">
				<Mode Name="Dual-Role-Device" UserName="OTG/Dual_Role_Device">
					<SignalLogicalOp Name="AND">
						<Signal Name="DM"/>
						<Signal Name="DP"/>
					</SignalLogicalOp>
					<Semaphore>OTG_DUAL_ROL_DEVICE_HS_FS</Semaphore>	
					<Semaphore>USB_OTG_HS_INT_Used_ForRCC</Semaphore>						
				</Mode>
				<!-- Tracker 333854 -->
				<Mode Name="Internal_Phy_Host" UserName="Host_Only">
					<SignalLogicalOp Name="AND">
						<Signal Name="DM"/>
						<Signal Name="DP"/>
					</SignalLogicalOp>	
					<Semaphore>MW_USB_OTG_HS_MW_HOST</Semaphore>		
					<Semaphore>USB_OTG_HS_INT_Used_ForRCC</Semaphore>		
					<Semaphore>SEMAOoUSBOoOTGOoHSOoHOSTOoFOROoUSBX</Semaphore>		
				</Mode>				
				<!-- Tracker 333854 -->
				<Mode Name="Internal_Phy_Device" UserName="Device_Only">
					<SignalLogicalOp Name="AND">
						<Signal Name="DM"/>
						<Signal Name="DP"/>
					</SignalLogicalOp>	
					<Semaphore>MW_USB_OTG_HS_MW_DEVICE</Semaphore>
					<Semaphore>USB_OTG_HS_INT_Used_ForRCC</Semaphore>
					<Semaphore>SEMAOoUSBOoOTGOoHSOoDEVICEOoFOROoUSBX</Semaphore>
					<Condition Expression="!MW_USB_OTG_FS_MW_DEVICE" Diagnostic="the Device mode is activated in USB_OTG_FS IP"/>
				</Mode>
			</ModeLogicOperator>	
			<Semaphore>$IpInstanceFS</Semaphore>
             <Semaphore>USB_OTG_HSEmbeddedPHYUsed_ForRCC</Semaphore>
			<Condition Expression="!$IpInstanceHS" Diagnostic=""/>			
		</Mode>	
		<Mode Name="Activate_SOF">
			<ModeLogicOperator Name="XOR">
				<Mode Name="Activate_SOF_FS" UserName="Activate-SOF">
					<SignalLogicalOp Name="AND">				
						<Signal Name="SOF"/>				
					</SignalLogicalOp>
				</Mode>						
			</ModeLogicOperator>
			<Semaphore>USB_FS_SOF</Semaphore>
			<!-- Tracker 325936 -->
			<Condition Expression="OTG_DUAL_ROL_DEVICE_HS_FS | MW_USB_OTG_HS_MW_HOST |MW_USB_OTG_HS_MW_DEVICE" Diagnostic="USB External or Internal Phy Mode in Host or Device mode must be selected first"/>
		</Mode>
		<Mode Name="Activate_VBUS">
			<ModeLogicOperator Name="XOR">
				<Mode Name="Activate_VBUS_FS" UserName="Activate-VBUS">
					<SignalLogicalOp Name="AND">				
						<Signal Name="VBUS"/>				
					</SignalLogicalOp>
					<Semaphore>VBUS_SENSING_ON_HS</Semaphore>
				</Mode>					
			</ModeLogicOperator>
			<!-- to keep compatibility with device mode -->
			<Condition Expression="OTG_DUAL_ROL_DEVICE_HS_FS | MW_USB_OTG_HS_MW_HOST |MW_USB_OTG_HS_MW_DEVICE" Diagnostic="USB External or Internal Phy Mode in Host or Device mode must be selected first"/>
		</Mode>	
	</ModeLogicOperator>	

	<RefSignal IOMode="AlternateFunctionPushPull" Name="DM"/>
	<RefSignal IOMode="AlternateFunctionPushPull" Name="DP"/>
	<RefSignal IOMode="AlternateFunctionPushPull" Name="ID"/>	
	<RefSignal IOMode="AlternateFunctionPushPull" Name="SOF"/>
	<RefSignal IOMode="Input" Name="VBUS"/>
	
	<!-- Clock Semaphore for this IP. -->
	<Semaphore>USB_OTG_HSUsed_ForRCC</Semaphore>
</IP>
