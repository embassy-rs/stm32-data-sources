			  <resetValue>0x00000000</resetValue>
			  <fields>
				<field>
				  <name>OPT_BUSY</name>
				  <description>Option byte change ongoing
				  flag</description>
				  <bitOffset>0</bitOffset>
				  <bitWidth>1</bitWidth>
				</field>
				<field>
				  <name>BOR_LEV</name>
