              </field>
              <field>
                <name>SDMMC1RST</name>
                <description>SDMMC1 and SDMMC1 delay blocks reset
Set and reset by software.</description>
                <bitOffset>16</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
