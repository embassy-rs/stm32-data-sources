                <enumeratedValues>
                  <enumeratedValue>
                    <name>B_0x0</name>
                    <description>Strict priority (SP). Queue 0 has the lowest priority and the last queue has the highest priority.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>Weighted Strict priority (WSP)</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>SCHALG</name>
