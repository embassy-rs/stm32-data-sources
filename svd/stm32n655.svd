                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>B_0x0</name>
                    <description>no HPDMA_CxTR3 update</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
