          <register>
            <name>RISAF_REG14_CFGR</name>
            <displayName>RISAF_REG14_CFGR</displayName>
            <description>RISAF region 14 configuration register</description>
            <addressOffset>0x380</addressOffset>
            <size>0x20</size>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>BREN</name>
                <description>base region enable</description>
                <bitOffset>0</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>B_0x0</name>
                    <description>Base region x is disabled. Access control of primary region 0 (secure, privileged) applies to any access between region x start and end addresses. Associated subregions are also disabled.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>Base region x is enabled. Access controls defined in region x apply to any access between region x start and end addresses.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>SEC</name>
                <description>secure region</description>
                <bitOffset>8</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>B_0x0</name>
                    <description>Only non-secure requests can access region x. SEC value in RISAF_REGx_zCFGR is internally treated as zeroed by RISAF (only non-secure requests to subregions).</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>Only secure requests can access region x, and optional subregions can be defined as secure or non-secure.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
