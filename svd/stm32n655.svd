                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>corresponding ULEF flag cleared</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
