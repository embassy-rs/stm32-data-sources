                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>ColorConv is enabled</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>TYPE</name>
