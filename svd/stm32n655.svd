                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>VLAN tagged PTPoE packets are routed to Rx Queue specified by PTPQ field (this Rx Queue can be enabled for AV or non-AV traffic)</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x2</name>
                    <description>VLAN tagged PTPoE packets are routed to only AV enabled Rx queues based on PSRQ.</description>
                    <value>0x2</value>
