              <field>
                <name>TCMFLXRBSEN</name>
                <description>I-TCM FLEXMEM backup supply enable (used to maintain I-TCM FLEX MEM content in Standby mode)</description>
                <bitOffset>4</bitOffset>
                <bitWidth>1</bitWidth>
