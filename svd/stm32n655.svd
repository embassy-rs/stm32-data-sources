                <enumeratedValues>
                  <enumeratedValue>
                    <name>B_0x0</name>
                    <description>NBL setup time is 0 fmc_ker_ck clock cycle.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>NBL setup time is 1 fmc_ker_ck clock cycle.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x2</name>
                    <description>NBL setup time is 2 fmc_ker_ck clock cycles.</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x3</name>
                    <description>NBL setup time is 3 fmc_ker_ck clock cycles.</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>FMC_BTR3</name>
            <displayName>FMC_BTR3</displayName>
            <description>SRAM/NOR Flash chip-select timing registers for memory region 3</description>
