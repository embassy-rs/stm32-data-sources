                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>VLAN tag deletion</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x2</name>
