                  <enumeratedValue>
                    <name>B_0x0</name>
                    <description>Weighted round robin (WRR) algorithm</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x3</name>
                    <description>Strict priority (SP) algorithm.</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
