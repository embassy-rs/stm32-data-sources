                    <description>3 re-tries allowed</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x2</name>
                    <description>15 re-tries allowed</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x3</name>
                    <description>63 re-tries allowed</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>WFA</name>
                <description>Wait for activityless thansup&gt;(1)less than/sup&gt;</description>
                <bitOffset>14</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>The SPDIFRX waits for activity on SPDIFRX_IN line (4 transitions) before performing the synchronization.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x0</name>
                    <description>The SPDIFRX does not wait for activity on SPDIFRX_IN line before performing the synchronization.</description>
                    <value>0x0</value>
                  </enumeratedValue>
