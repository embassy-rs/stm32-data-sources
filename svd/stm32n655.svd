                  <enumeratedValue>
                    <name>B_0x0</name>
                    <description>No Tx message completed</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>Tx message completed</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>TXMSGABT</name>
                <description>Transmit message abort</description>
                <bitOffset>3</bitOffset>
                <bitWidth>1</bitWidth>
