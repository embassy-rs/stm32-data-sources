                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>Writes to MCE_CCzCFGR and MCE_CCzNR registers are ignored until next MCE reset.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
