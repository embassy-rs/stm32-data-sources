    <peripheral>
        <name>GFXTIM</name>
        <description>Graphic timer</description>
		<groupName>GFXTIM</groupName>
        <baseAddress>0x48004000</baseAddress>
		<addressBlock>
          <offset>0x0</offset>
          <size>0x1000</size>
          <usage>registers</usage>
        </addressBlock>		
		<interrupt>
          <name>GFXTIM</name>
          <description>GFXTIM global interrupt</description>
          <value>64</value>
        </interrupt>
        <registers>
          <register>
            <name>GFXTIM_CR</name>
            <displayName>GFXTIM_CR</displayName>
            <description>GFXTIM configuration register</description>
            <addressOffset>0x0000</addressOffset>
            <size>0x20</size>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>TES</name>
                <description>tearing source</description>
                <bitOffset>0</bitOffset>
                <bitWidth>2</bitWidth>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>B_0x0</name>
                    <description>TE input pad selected</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>gfxtim_ite selected</description>
                    <value>0x1</value>
                  </enumeratedValue>
