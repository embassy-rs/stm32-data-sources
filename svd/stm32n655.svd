            <addressOffset>0x800</addressOffset>
            <size>0x20</size>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>SPLOCK0</name>
                <description>Sticky programming lock for word 0</description>
                <bitOffset>0</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>B_0x0</name>
                    <description>Fuse word 0 can be burnt in fuse memory array</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
