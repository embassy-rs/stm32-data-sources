                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>Bitstream clock generated on the MDF_CCK0 pad</description>
                    <value>0x1</value>
                  </enumeratedValue>
