          <register>
            <name>DCMI_ESUR</name>
            <displayName>DCMI_ESUR</displayName>
            <description>DCMI embedded synchronization unmask register</description>
            <addressOffset>0x1C</addressOffset>
            <size>0x20</size>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>FSU</name>
                <description>Frame start delimiter unmask</description>
                <bitOffset>0</bitOffset>
                <bitWidth>8</bitWidth>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>B_0x0</name>
                    <description>The corresponding bit in the FSC byte in DCMI_ESCR is masked while comparing the frame start delimiter with the received data.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>The corresponding bit in the FSC byte in DCMI_ESCR is compared while comparing the frame start delimiter with the received data.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>LSU</name>
                <description>Line start delimiter unmask</description>
                <bitOffset>8</bitOffset>
                <bitWidth>8</bitWidth>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>B_0x0</name>
                    <description>The corresponding bit in the LSC byte in DCMI_ESCR is masked while comparing the line start delimiter with the received data.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>The corresponding bit in the LSC byte in DCMI_ESCR is compared while comparing the line start delimiter with the received data.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
