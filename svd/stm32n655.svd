                  <enumeratedValue>
                    <name>B_0x0</name>
                    <description>Corresponding memory region is disabled</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>Corresponding memory region is enabled</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>MUXEN</name>
                <description>Address/data multiplexing enable bit</description>
