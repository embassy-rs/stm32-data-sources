                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>1v8 voltage range selected. HSLV_VDDIO4 option bit must be set to allow 1v8 voltage range operation. Setting this configuration while Vless thansub&gt;DDIO4less than/sub&gt; is in 3v3 range damages the device.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
