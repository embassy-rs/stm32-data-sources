                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>B_0x0</name>
                    <description>No interrupt generation</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
