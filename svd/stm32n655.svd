                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>B_0x0</name>
                    <description>Values inside FMC_BWTR register not taken into account (default after reset)</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>Values inside FMC_BWTR register taken into account</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
