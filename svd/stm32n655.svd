                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>Modulation Spread-Spectrum and Fractional Divide are active</description>
                    <value>0x1</value>
                  </enumeratedValue>
