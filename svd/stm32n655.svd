                    <description>Index always active</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>Index disabled hen tim_ti3 input is active, as per CC3P bitfield</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x2</name>
                    <description>Index disabled when tim_ti4 input is active, as per CC4P bitfield</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  </enumeratedValues>
              </field>
              <field>
                <name>FIDX</name>
                <description>First index </description>
