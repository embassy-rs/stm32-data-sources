          <description>RIF can generate an interrupt when a laser attack is detected</description>
          <value>12</value>
        </interrupt>		 		 
        <registers>
          <register>
            <name>RIFSC_RISC_CR</name>
            <displayName>RIFSC_RISC_CR</displayName>
