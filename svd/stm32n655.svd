                  <enumeratedValue>
                    <name>B_0x0</name>
                    <description>write: ignored, read: channel disabled</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>write: enable channel, read: channel enabled</description>
                    <value>0x1</value>
