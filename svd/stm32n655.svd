              </field>
              <field>
                <name>GC5C1</name>
                <description>Group channel 5 and channel 1</description>
                <bitOffset>29</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>B_0x0</name>
