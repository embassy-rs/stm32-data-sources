                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x21</name>
                    <description>- 44.6 dB</description>
                    <value>0x21</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x22</name>
                    <description>- 42.1 dB or shift right by 7 bits</description>
                    <value>0x22</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x23</name>
                    <description>- 38.6 dB</description>
                    <value>0x23</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x2E</name>
                    <description>- 6 dB or shift right by 1 bit</description>
                    <value>0x2E</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x2F</name>
                    <description>- 2.5 dB</description>
                    <value>0x2F</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
