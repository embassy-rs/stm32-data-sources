          <register>
            <name>HPDMA_C4SEMCR</name>
            <displayName>HPDMA_C4SEMCR</displayName>
            <description>HPDMA channel 4 semaphore control register</description>
            <addressOffset>0x258</addressOffset>
            <size>0x20</size>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>SEM_MUTEX</name>
                <description>mutual exclusion semaphore for the CID allocation of the channel x (in semaphore mode)</description>
                <bitOffset>0</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>B_0x0_WRITE</name>
                    <description>release the control of the channel x (in semaphore mode) to any white-listed CID</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x1_WRITE</name>
                    <description>take the control of the channel x (in semaphore mode), from one of the white-listed CID pool</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  </enumeratedValues>
              </field>
              <field>
                <name>SEM_CCID</name>
                <description>current CID allocated to the channel x (in semaphore mode)</description>
                <bitOffset>4</bitOffset>
                <bitWidth>3</bitWidth>
                <access>read-only</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>B_0x0</name>
                    <description>CID0 is the last white-listed CID that took the control of the channel x.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>CID1 is the last white-listed CID that took the control of the channel x.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x2</name>
                    <description>CID2 is the last white-listed CID that took the control of the channel x.</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x3</name>
                    <description>CID3 is the last white-listed CID that took the control of the channel x.</description>
                    <value>0x3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x4</name>
                    <description>CID4 is the last white-listed CID that took the control of the channel x.</description>
                    <value>0x4</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x5</name>
                    <description>CID5 is the last white-listed CID that took the control of the channel x.</description>
                    <value>0x5</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x6</name>
                    <description>CID6 is the last white-listed CID that took the control of the channel x.</description>
                    <value>0x6</value>
                  </enumeratedValue>
                  </enumeratedValues>
              </field>
            </fields>
