            <displayName>DCMIPP_P1YUVBR1</displayName>
            <description>DCMIPP Pipe1 YUVConv blue coefficient register 1</description>
            <addressOffset>0x994</addressOffset>
            <size>0x20</size>
            <resetValue>0x00000000</resetValue>
