                    <description>no FIFO underrun warning interrupt generated</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>FIFO underrun warning interrupt generated, if one of the layer FIFO is empty and pixel data is read from the FIFO</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>TERRIF</name>
                <description>Transfer error interrupt flag</description>
