                    <description>A handshake is sent based on the FIFO status and the NAK and STALL bit settings.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>No data is written to the Rx FIFO, irrespective of space availability. Sends a NAK handshake on all packets, except on SETUP transactions. All isochronous OUT packets are dropped.</description>
                    <value>0x1</value>
                  </enumeratedValue>
