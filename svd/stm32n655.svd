                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>register reload interrupt generated when a vertical blanking reload occurs (and the first line after the active area is reached)</description>
                    <value>0x1</value>
