                    <description>DMA mode is enabled for reception.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x0</name>
                    <description>DMA mode is disabled for reception.</description>
                    <value>0x0</value>
                  </enumeratedValue>
