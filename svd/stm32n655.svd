                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>The counter value has been captured in LPTIM_CCR1 register while CC1IF flag was already set.</description>
                    <value>0x1</value>
                  </enumeratedValue>
