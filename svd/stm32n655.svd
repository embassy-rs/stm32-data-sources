                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>DMA Channel 1</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>Q1DDMACH</name>
                <description>Queue 1 Enabled for DA-based DMA Channel Selection</description>
