                    <description>The parity error bit is not copied into the SPDIFRX_FMTx_DR, a zero is written instead.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x0</name>
                    <description>The parity error bit is copied into the SPDIFRX_FMTx_DR.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
