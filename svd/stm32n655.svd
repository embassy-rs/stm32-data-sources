                <enumeratedValues>
                  <enumeratedValue>
                    <name>B_0x0</name>
                    <description>New Tx data write not required</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>New Tx data write required</description>
                    <value>0x1</value>
                  </enumeratedValue>
