            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>SPDIFRXEN</name>
                <description>Peripheral block enableless thansup&gt;(1)less than/sup&gt;</description>
