            <fields>
              <field>
                <name>SEC0</name>
                <description>I/O pin y of Port x security configuration</description>
                <bitOffset>0</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>B_0x0</name>
                    <description>The I/O pin y is non-secure. Secure access is also possible.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>The I/O pin y is secure (see Table 70 for all corresponding secure bits).</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
