                    <description>low level is active for SS signal</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>high level is active for SS signal</description>
                    <value>0x1</value>
                  </enumeratedValue>
