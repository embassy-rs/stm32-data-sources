                <enumeratedValues>
                  <enumeratedValue>
                    <name>B_0x0</name>
                    <description>OLDx event interrupt disabled</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>OLDx event interrupt enabled</description>
                    <value>0x1</value>
