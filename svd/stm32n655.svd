                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>low priority, mid weight</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x2</name>
                    <description>low priority, high weight</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
