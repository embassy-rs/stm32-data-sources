                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>Serial clock source is MDF_CCK1.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>SITFMOD</name>
