              <field>
                <name>POTTAMPERSETMASK</name>
                <description>This bit can be set by software to mask PKA, SAES, CRYP1/2, and HASH reset, in case of potential tamper.</description>
                <bitOffset>0</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>B_0x0</name>
                    <description>PKA, SAES, CRYP1/2, and HASH reset in case of potential tamper</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>PKA, SAES, CRYP1/2, and HASH not reset in case of potential tamper</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>SYSCFG_ICNEWRCR</name>
            <displayName>SYSCFG_ICNEWRCR</displayName>
            <description>SYSCFG AHB-AXI bridge early write response control	register</description>
            <addressOffset>0x034</addressOffset>
            <size>0x20</size>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>SDMMC1_EARLY_WR_RSP_ENABLE</name>
                <description>None</description>
                <bitOffset>0</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>B_0x0</name>
                    <description>Early-write response disabled. The last AHB write data beat receives the AXI buffered response for the complete AHB transaction.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>Early-write response enabled. AHB-Lite write data beats receive an automatic OK response from the AHB-to-AXI bridge, whatever the B-channel AXI response.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
