                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>SS input value is determined by the SSI bit</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
