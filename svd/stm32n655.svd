                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>Sincless thansup&gt;1less than/sup&gt; filter type</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x2</name>
                    <description>Sincless thansup&gt;2less than/sup&gt; filter type</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x3</name>
