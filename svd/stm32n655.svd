                  <enumeratedValue>
                    <name>B_0x0</name>
                    <description>Address/Data non-multiplexed</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>Address/Data multiplexed on databus (default after reset)</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>MTYP</name>
