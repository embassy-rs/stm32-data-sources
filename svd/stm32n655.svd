                <enumeratedValues>
                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>DATAST phase duration = 1 * fmc_ker_ck clock cycles</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x2</name>
                    <description>DATAST phase duration = 2 * fmc_ker_ck clock cycles</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0xFF</name>
                    <description>DATAST phase duration = 255 * fmc_ker_ck clock cycles (default value after reset)</description>
                    <value>0xFF</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>BUSTURN</name>
                <description>Bus turnaround phase duration</description>
