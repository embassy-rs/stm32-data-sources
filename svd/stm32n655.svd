                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>Writes to MCE_CCzKEYR registers are ignored until next MCE reset. KEYCRC bitfield value does not change.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
