                <bitOffset>0</bitOffset>
                <bitWidth>16</bitWidth>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>HPDMA_C10SAR</name>
            <displayName>HPDMA_C10SAR</displayName>
