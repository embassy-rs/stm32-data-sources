                  <enumeratedValue>
                    <name>B_0x0</name>
                    <description>All pixels are transmitted, no horizontal decimation</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>One line out of two transmitted</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>VDEC</name>
