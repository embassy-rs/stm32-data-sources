                    <description>No Tx message discarded</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>Tx message discarded</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>TXMSGSENT</name>
                <description>Message transmission completed</description>
                <bitOffset>2</bitOffset>
                <bitWidth>1</bitWidth>
