                <enumeratedValues>
                  <enumeratedValue>
                    <name>B_0x0</name>
                    <description>The clock pulse of the last data bit is not output to the CK pin</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>The clock pulse of the last data bit is output to the CK pin</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
