                    <description>audio subblock in asynchronous mode.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>audio subblock is synchronous with the other internal audio subblock. In this case, the audio subblock must be configured in slave mode</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x2</name>
