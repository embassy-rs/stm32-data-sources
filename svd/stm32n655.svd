          <name>WWDG_EARLY</name>
          <description>Window watchdog interrupt</description>
          <value>19</value>
        </interrupt>
        <registers>
          <register>
            <name>WWDG_CR</name>
            <displayName>WWDG_CR</displayName>
            <description>WWDG control register</description>
