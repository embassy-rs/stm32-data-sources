                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>+ 3.5 dB</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x2</name>
                    <description>+ 6 dB or shift left by 1 bit</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x18</name>
                    <description>+ 72 dB or shift left by 12 bits</description>
                    <value>0x18</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x20</name>
                    <description>- 48.2 dB or shift right by 8 bits (default value)</description>
                    <value>0x20</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x21</name>
                    <description>- 44.6 dB</description>
                    <value>0x21</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x22</name>
                    <description>- 42.1 dB or shift right by 7 bits</description>
                    <value>0x22</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x23</name>
                    <description>- 38.6 dB</description>
                    <value>0x23</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x2E</name>
                    <description>- 6 dB or shift right by 1 bit</description>
                    <value>0x2E</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x2F</name>
                    <description>- 2.5 dB</description>
                    <value>0x2F</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
