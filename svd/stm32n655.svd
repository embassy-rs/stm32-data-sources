          <register>
            <name>LPTIM2_CCMR1</name>
            <displayName>LPTIM2_CCMR1</displayName>
            <description>LPTIM2 capture/compare mode register 1</description>
            <addressOffset>0x02C</addressOffset>
            <size>0x20</size>
            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>CC1SEL</name>
                <description>Capture/compare 1 selection</description>
                <bitOffset>0</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>B_0x0</name>
                    <description>CC1 channel is configured in output PWM mode</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>CC1 channel is configured in input capture mode</description>
                    <value>0x1</value>
                  </enumeratedValue>
