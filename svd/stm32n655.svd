                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x3_CC1_AS_INPUT</name>
                    <description>both edges, circuit is sensitive to both IC1 rising and falling edges.</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
