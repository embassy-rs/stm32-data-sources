          <register>
            <name>LPTIM2_RCR</name>
            <displayName>LPTIM2_RCR</displayName>
            <description>LPTIM2 repetition register</description>
            <addressOffset>0x028</addressOffset>
            <size>0x20</size>
            <resetValue>0x00000000</resetValue>
