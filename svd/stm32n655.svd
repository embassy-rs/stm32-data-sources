                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>Reshape filter bypassed</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>RSFLTD</name>
                <description>Reshaper filter decimation ratio</description>
                <bitOffset>4</bitOffset>
