                  <enumeratedValue>
                    <name>B_0x3_PAM_1</name>
                    <description>successive source data are FIFO queued and packed at the destination data width, in a left (LSB) to right (MSB) order (named little endian), before a destination transfer</description>
                    <value>0x3</value>
