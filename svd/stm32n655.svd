                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x0</name>
                    <description>Early suspend interrupt is generated on erratic error</description>
                    <value>0x0</value>
                  </enumeratedValue>
                </enumeratedValues>
