                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>ADC triggers generated when Channel 2 is active (in push-pull mode)</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
