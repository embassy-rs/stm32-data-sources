            </field>
            <field>
              <name>CMP4</name>
              <description>Compare 4 interrupt flag</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>REP</name>
