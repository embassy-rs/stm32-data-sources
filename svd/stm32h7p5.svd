        <register>
          <name>HRTIM_TIMDCR2</name>
          <displayName>HRTIM_TIMDCR2</displayName>
          <description>HRTIM timer D control register 2</description>
          <addressOffset>0x46C</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>DCDE</name>
