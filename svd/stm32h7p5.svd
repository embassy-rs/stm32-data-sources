                  <name>B_0x1</name>
                  <description>Voltage level valid, at current ACTVOS selected levels.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PVDO</name>
