                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>Fault 8 input is active and disables HRTIM outputs</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FLT1A2EN</name>
              <description>Fault 1 AND Fault 2 enable</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
