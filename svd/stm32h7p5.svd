                <enumeratedValue>
                  <name>B_0x0</name>
                  <description>Automatic erase of AXISRAM1 memory ongoing</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
