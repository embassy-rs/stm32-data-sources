                  <description>Iless thansup&gt;2less than/sup&gt;S Philips standard.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>MSB-justified standard (left justified)</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x2</name>
                  <description>LSB-justified standard (right justified)</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x3</name>
                  <description>PCM standard</description>
                  <value>0x3</value>
                </enumeratedValue>
