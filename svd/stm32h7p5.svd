              <enumeratedValues>
                <enumeratedValue>
                  <name>B_0x0</name>
                  <description>No option byte key reading or programming error occurred</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>A double error detection was found when loading the requested option byte key, or the programming of a non-virgin key was detected during the last programming operation.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>OPTERRF</name>
