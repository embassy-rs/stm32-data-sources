                  <description>reset not activated (default after Backup domain reset)</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>generates a reset pulse, resetting the entire VSW domain.</description>
                  <value>0x1</value>
                </enumeratedValue>
