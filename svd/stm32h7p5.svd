                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x3</name>
                  <description>SOP'_Debug detected in receiver</description>
                  <value>0x3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x4</name>
                  <description>SOP''_Debug detected in receiver</description>
                  <value>0x4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x5</name>
                  <description>Cable Reset detected in receiver</description>
                  <value>0x5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x6</name>
                  <description>SOP extension#1 detected in receiver</description>
                  <value>0x6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x7</name>
                  <description>SOP extension#2 detected in receiver</description>
                  <value>0x7</value>
