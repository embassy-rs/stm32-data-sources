                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>ADC triggers generated when Channel 1 is active (in push-pull mode)</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
