          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>PDDS</name>
              <description>Power-down Deepsleep.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
