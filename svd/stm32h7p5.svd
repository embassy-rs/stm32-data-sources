    <peripheral>
      <name>HRTIM1</name>
      <description>HRTIM register block</description>
      <groupName>HRTIM</groupName>
      <baseAddress>0x42006000</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x800</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>HRTIM1_FLT</name>
        <description>HRtimer1 error interrupt</description>
        <value>171</value>
      </interrupt>
      <interrupt>
        <name>HRTIM1_TIMF</name>
        <description>HRtimer1 slave6 interrupt</description>
        <value>170</value>
      </interrupt>
      <interrupt>
        <name>HRTIM1_TIME</name>
        <description>HRtimer1 slave5 interrupt</description>
        <value>169</value>
      </interrupt>
      <interrupt>
        <name>HRTIM1_TIMD</name>
        <description>HRtimer1 slave4 interrupt</description>
        <value>168</value>
      </interrupt>
      <interrupt>
        <name>HRTIM1_TIMC</name>
        <description>HRtimer1 slave3 interrupt</description>
        <value>167</value>
      </interrupt>
      <interrupt>
        <name>HRTIM1_TIMB</name>
        <description>HRtimer1 slave2 interrupt</description>
        <value>166</value>
      </interrupt>
      <interrupt>
        <name>HRTIM1_TIMA</name>
        <description>HRtimer1 slave1 interrupt</description>
        <value>165</value>
      </interrupt>
      <interrupt>
        <name>HRTIM1_M</name>
        <description>HRtimer1 master interrupt</description>
        <value>164</value>
      </interrupt>
      <registers>
        <register>
          <name>HRTIM_MCR</name>
          <displayName>HRTIM_MCR</displayName>
          <description>HRTIM master timer control register</description>
          <addressOffset>0x000</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>CKPSC</name>
              <description>Clock prescaler</description>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CONT</name>
              <description>Continuous mode</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>B_0x0</name>
                  <description>The timer operates in single-shot mode and stops when it reaches the MPER value</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>The timer operates in continuous (free-running) mode and rolls over to zero when it reaches the MPER value</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RETRIG</name>
              <description>Re-triggerable mode</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>B_0x0</name>
                  <description>The timer is not re-triggerable: a counter reset can be done only if the counter is stopped (period elapsed)</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>The timer is re-triggerable: a counter reset is done whatever the counter state (running or stopped)</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>HALF</name>
              <description>Half mode</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>B_0x0</name>
                  <description>Half mode disabled</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>Half mode enabled</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>INTLVD</name>
              <description>Interleaved mode</description>
              <bitOffset>6</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>B_0x0</name>
                  <description>Interleaved mode disabled</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>Triple interleaved mode: when HRTIM_MPER register is written, the HRTIM_MCMP1R active register is automatically updated with HRTIM_MPER/3 value, and the HRTIM_MCMP2R active register is automatically updated with 2x (HRTIM_MPER/3) value.</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x2</name>
                  <description>Quad interleaved mode: when HRTIM_MPER register is written, the HRTIM_MCMP1R active register is automatically updated with HRTIM_MPER/4 value, the HRTIM_MCMP2R active register is automatically updated with HRTIM_MPER/2 value and the HRTIM_MCMP3R active register is automatically updated with 3x (HRTIM_MPER/4) value.</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x3</name>
                  <description>Interleaved mode disabled</description>
                  <value>0x3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SYNCIN</name>
              <description>Synchronization input</description>
              <bitOffset>8</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>B_0x0</name>
                  <description>Disabled. HRTIM is not synchronized and runs in standalone mode.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>Internal event on hrtim_in_sync[1], from other on-chip HRTIM instances</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x2</name>
                  <description>Internal event on hrtim_in_sync[2]: the HRTIM is synchronized with the on-chip timer (see Section: Synchronization input).</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x3</name>
                  <description>External event on hrtim_in_sync[3]: a positive pulse on HRTIM_SCIN input triggers the HRTIM.</description>
                  <value>0x3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SYNCRSTM</name>
              <description>Synchronization resets master</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>B_0x0</name>
                  <description>No effect on the master timer</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>A synchronization input event resets the master timer</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SYNCSTRTM</name>
              <description>Synchronization starts master</description>
