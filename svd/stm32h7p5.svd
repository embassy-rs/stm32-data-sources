                  <description>Writing 0 has no effect (default after Backup domain reset)</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>Writing 1 generates a re-arm pulse for the LSECSS function</description>
