              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>TE1RST</name>
              <description>Timer E output 1 reset</description>
              <bitOffset>29</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>TECMP1</name>
