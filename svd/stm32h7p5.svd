                  <description>x fmc_ker_ck cycles (+ wait cycle introduced by deasserting NWAIT)</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0xFE</name>
                  <description>255 x fmc_ker_ck cycles (+ wait cycle introduced by deasserting NWAIT)</description>
                  <value>0xFE</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
