              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>1fmc_ker_ck cycle for write access / 3fmc_ker_ck cycle for read access</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0xFE</name>
                  <description>254fmc_ker_ck cycles for write access / 257fmc_ker_ck cycles for read access</description>
                  <value>0xFE</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MEMHIZ</name>
