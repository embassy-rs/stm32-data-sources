              <enumeratedValues>
                <enumeratedValue>
                  <name>B_0x0</name>
                  <description>0 x fmc_ker_ck cycle</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0xFE</name>
                  <description>254 x fmc_ker_ck cycles</description>
                  <value>0xFE</value>
                </enumeratedValue>
              </enumeratedValues>
