                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x8</name>
                  <description>fless thansub&gt;SAMPLINGless than/sub&gt; = fless thansub&gt;DTS2less than/sub&gt;/8, N = 6</description>
                  <value>0x8</value>
