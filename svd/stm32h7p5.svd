              <access>read-write</access>
            </field>
            <field>
              <name>TF1RST</name>
              <description>Timer F output 1 reset</description>
              <bitOffset>25</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>TFCMP1</name>
              <description>Timer F compare 1</description>
              <bitOffset>26</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>TFCMP2</name>
              <description>Timer F compare 2</description>
              <bitOffset>27</bitOffset>
              <bitWidth>1</bitWidth>
