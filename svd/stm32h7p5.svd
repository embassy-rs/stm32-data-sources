          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>DBG_CPU</name>
              <description>Drives the CPU external debug request (EDBGRQ) signal. This signal can be used to halt the CPU in debug on a system reset, instead of writing to the DEMCR.VC_CORERESET bit in the CPU</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>B_0x0</name>
                  <description>External debug request de-asserted</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>The external debug request, EDBGRQ, is asserted when the system reset is active and remains asserted until the cpu is Halted.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
