                  <description>No action</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>The update event triggers the capture 2</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>EXEVACPT</name>
              <description>External event A capture</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
