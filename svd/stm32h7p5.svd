                  <description>Inactive</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x3</name>
                  <description>High-Z</description>
                  <value>0x3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
