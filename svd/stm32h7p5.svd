                  <description>Sampling time control trigger mode disabled</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>Sampling time control trigger mode enabled</description>
                  <value>0x1</value>
                </enumeratedValue>
