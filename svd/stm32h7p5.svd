        <register>
          <name>HRTIM_CPT2DCR</name>
          <displayName>HRTIM_CPT2DCR</displayName>
          <description>HRTIM timer D capture 2 control register</description>
          <addressOffset>0x460</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>SWCPT</name>
              <description>Software capture</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
