                  <description>fmc_ker_ck cycles</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0xFE</name>
                  <description>255 x fmc_ker_ck cycles</description>
                  <value>0xFE</value>
                </enumeratedValue>
