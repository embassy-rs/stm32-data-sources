                  <description>80% of the frame interval</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>85% of the frame interval</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x2</name>
                  <description>90% of the frame interval</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x3</name>
                  <description>95% of the frame interval</description>
                  <value>0x3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
