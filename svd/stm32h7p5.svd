                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>Port 1 (AHB) allocated</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DDW_LOG2</name>
