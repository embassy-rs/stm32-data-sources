                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>Preload enabled: the write access is done into the preload register</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
