                <enumeratedValue>
                  <name>B_0x0</name>
                  <description>Internal buffer disabled for write operations</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>Internal buffer enabled for write operations</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SER</name>
