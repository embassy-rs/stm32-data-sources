                  <value>0xA3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x5C</name>
                  <description>HDP extension area is active, and can be increased (not decreased) with HDP_AREA_EXT[11:0].</description>
                  <value>0x5C</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>FLASH_OPTKEYR</name>
          <displayName>FLASH_OPTKEYR</displayName>
