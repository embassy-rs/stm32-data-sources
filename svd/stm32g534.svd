                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>Delayed protection is enabled, as per DLYPRT[2:0] bits</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
