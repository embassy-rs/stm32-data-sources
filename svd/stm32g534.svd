                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>Active</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x2</name>
                  <description>Inactive</description>
                  <value>0x2</value>
                </enumeratedValue>
