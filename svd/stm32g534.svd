              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>B_0x0</name>
                  <description>No action</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>Delayed protection is enabled, as per DLYPRT[2:0] bits</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
