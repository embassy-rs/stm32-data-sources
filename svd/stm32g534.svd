                <enumeratedValue>
                  <name>B_0x2</name>
                  <description>Event generated when the counter is equal to HRTIM_PERxR</description>
                  <value>0x2</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>BMROM</name>
