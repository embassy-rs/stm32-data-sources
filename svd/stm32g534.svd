              <enumeratedValues>
                <enumeratedValue>
                  <name>B_0x0</name>
                  <description>No compare 1 interrupt occurred</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>Compare 1 interrupt occurred</description>
                  <value>0x1</value>
