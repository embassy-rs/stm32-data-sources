                <enumeratedValue>
                  <name>B_0x0</name>
                  <description>Master timer counter reset/roll-over</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>Timer A counter reset/roll-over</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x2</name>
                  <description>Timer B counter reset/roll-over</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x3</name>
                  <description>Timer C counter reset/roll-over</description>
                  <value>0x3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x4</name>
                  <description>Timer D counter reset/roll-over</description>
                  <value>0x4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x5</name>
                  <description>Timer E counter reset/roll-over</description>
                  <value>0x5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x6</name>
                  <description>On-chip event 1 (hrtim_bm_ck1), acting as a burst mode counter clock</description>
                  <value>0x6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x7</name>
                  <description>On-chip event 2 (hrtim_bm_ck2) acting as a burst mode counter clock</description>
                  <value>0x7</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x8</name>
                  <description>On-chip event 3 (hrtim_bm_ck3) acting as a burst mode counter clock</description>
                  <value>0x8</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x9</name>
                  <description>On-chip event 4 (hrtim_bm_ck4) acting as a burst mode counter clock</description>
                  <value>0x9</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0xA</name>
                  <description>Prescaled fless thansub&gt;HRTIMless than/sub&gt; clock (as per BMPRSC[3:0] setting)</description>
                  <value>0xA</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0xB</name>
                  <description>Timer F counter reset/roll-over</description>
                  <value>0xB</value>
                </enumeratedValue>
              </enumeratedValues>
