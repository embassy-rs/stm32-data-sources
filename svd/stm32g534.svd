                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>High frequency interface mode enabled for 80MHz less than or equal dac_ker_ck less than or equal xA0MHz</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x2</name>
                  <description>High frequency interface mode enabled for xA0MHz less than or equal dac_ker_ck</description>
                  <value>0x2</value>
                </enumeratedValue>
