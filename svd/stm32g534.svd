            </field>
            <field>
              <name>OC6M_1</name>
              <description>OC6M[4:3]</description>
              <bitOffset>24</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>TIM_DTR2</name>
          <displayName>TIM_DTR2</displayName>
