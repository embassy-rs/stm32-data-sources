                  <name>B_0x2</name>
                  <description>Positive pulse on HRTIM_SCOUT output (16x fless thansub&gt;HRTIMless than/sub&gt; clock cycles)</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x3</name>
                  <description>Negative pulse on HRTIM_SCOUT output (16x fless thansub&gt;HRTIMless than/sub&gt; clock cycles)</description>
