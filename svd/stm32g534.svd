              <enumeratedValues>
                <enumeratedValue>
                  <name>B_0xC3</name>
                  <description>Flash Bank 1 mapped at 0x0800 0000 (and aliased @0x0C00 0000) and Flash Bank 2 mapped at 0x0804 0000 (and aliased at 0x0C04 0000)</description>
                  <value>0xC3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0xB4</name>
