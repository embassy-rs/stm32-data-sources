                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>Capture 2 is triggered by TA1 output inactive to active transition</description>
                  <value>0x1</value>
                </enumeratedValue>
