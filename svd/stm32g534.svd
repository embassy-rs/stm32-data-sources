                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>CSS on LSE oscillator ON</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>LSECSSD</name>
