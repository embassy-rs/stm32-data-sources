                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>Fault 1 input is active and disables HRTIM outputs</description>
                  <value>0x1</value>
                </enumeratedValue>
