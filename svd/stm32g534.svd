                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TI4FS</name>
              <description>tim_ti4f status</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>B_0x0</name>
                  <description>tim_ti4f signal is low</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>tim_ti4f signal is high</description>
                  <value>0x1</value>
