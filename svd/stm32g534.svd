              <enumeratedValues>
                <enumeratedValue>
                  <name>B_0x0</name>
                  <description>Positive polarity (output active high)</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>Negative polarity (output active low)</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
