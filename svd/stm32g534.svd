                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>Event generated when the counter is equal to 0</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x2</name>
                  <description>Event generated when the counter is equal to HRTIM_PERxR</description>
                  <value>0x2</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>OUTROM</name>
