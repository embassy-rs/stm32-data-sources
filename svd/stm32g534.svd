                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>The trigger is generated on output 1 reset event</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DCDR</name>
