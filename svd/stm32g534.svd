        <register>
          <name>HRTIM_COFEER</name>
          <displayName>HRTIM_COFEER</displayName>
          <description>HRTIM timer E crossbar override forcing event register</description>
          <addressOffset>0x57C</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
