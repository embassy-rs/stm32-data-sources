              <enumeratedValues>
                <enumeratedValue>
                  <name>B_0x0</name>
                  <description>no OBK is copied from current to alternate OBK page during SWAP operation.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>only the first OBK data (128 bits) are copied from current to alternate OBK page</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x2</name>
                  <description>the two first OBK data are copied</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1FF</name>
                  <description>that the 511 first OBK data are copied</description>
                  <value>0x1FF</value>
                </enumeratedValue>
              </enumeratedValues>
