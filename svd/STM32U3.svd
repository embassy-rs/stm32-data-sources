0: no GPDMA_CxDAR update
1: GPDMA_CxDAR update
</description>
              <bitOffset>27</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
