                  <description>DAC channel2 trigger enabled and data from the DAC_DHR2 register are transferred three dac_pclk clock cycles later to the DAC_DOR2 register</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
