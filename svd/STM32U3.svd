            <field>
              <name>UT2</name>
              <description>This bit controls the update of GPDMA_C3TR2 from the memory during the link transfer.
0: no GPDMA_C3TR2 update
1: GPDMA_C3TR2 update
</description>
              <bitOffset>30</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
