            <field>
              <name>UT1</name>
              <description>This bit controls the update of GPDMA_C3TR1 from the memory during the link transfer.
0: no GPDMA_C3TR1 update
1: GPDMA_C3TR1 update
</description>
              <bitOffset>31</bitOffset>
