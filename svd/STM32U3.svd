                  <description>THRless thansub&gt;H less than/sub&gt;is 27.</description>
                  <value>0x8</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x9</name>
                  <description>THRless thansub&gt;H less than/sub&gt;is 30.</description>
                  <value>0x9</value>
                </enumeratedValue>
