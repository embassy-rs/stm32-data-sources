        <register>
          <name>GTZC1_MPCBB2_SECCFGR0</name>
          <displayName>GTZC1_MPCBB2_SECCFGR0</displayName>
          <description>GTZC1 SRAM2 MPCBB security configuration for super-block 0 register</description>
          <addressOffset>0x100</addressOffset>
          <size>0x20</size>
          <resetValue>0xFFFFFFFF</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>SEC0</name>
              <description>Unprivileged write to this bit is ignored if PRIV0 bit is set in GTZC1_MPCBB2_PRIVCFGR0.
Writes are ignored if SPLCK0 bit is set in GTZC1_MPCBB2_CFGLOCKR1.
0: Non-secure access only to block 0, belonging to super-block 0. Secure access is also allowed if the SRWILADIS bit is set in GTZC1_MPCBBz_CR.
1: Secure access only to block 0, belonging to super-block 0.
</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>B_0x0</name>
                  <description>Non-secure access only to block 0, belonging to super-block 0. Secure access is also allowed if the SRWILADIS bit is set in GTZC1_MPCBBz_CR.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>Secure access only to block 0, belonging to super-block 0.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SEC1</name>
              <description>Unprivileged write to this bit is ignored if PRIV1 bit is set in GTZC1_MPCBB2_PRIVCFGR0.
