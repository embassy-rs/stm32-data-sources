              <enumeratedValues>
                <enumeratedValue>
                  <name>B_0x0</name>
                  <description>No error detected during protected PKA operation (if applicable)</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>CCB RCC reset has been detected when OPSTEP &gt; 0x0</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x2</name>
                  <description>SAES RCC reset has been detected when OPSTEP &gt; 0x0</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x3</name>
                  <description>PKA RCC reset has been detected when OPSTEP &gt; 0x0</description>
                  <value>0x3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x4</name>
                  <description>RNG RCC reset has been detected when OPSTEP &gt; 0x0</description>
                  <value>0x4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x5</name>
                  <description>The RCC has gated the CCB clock when OPSTEP &gt; 0x0</description>
                  <value>0x5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x6</name>
                  <description>The RCC has gated the SAES clock when OPSTEP &gt; 0x0</description>
                  <value>0x6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x7</name>
                  <description>The RCC has gated the PKA clock when OPSTEP &gt; 0x0</description>
                  <value>0x7</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x8</name>
                  <description>The RCC has gated the RNG clock when OPSTEP &gt; 0x0</description>
                  <value>0x8</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x9</name>
                  <description>Random in SAES_IV1 is trivial (all 0s or all 1s) when OPSTEP = 0x2</description>
                  <value>0x9</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0xA</name>
                  <description>Random in SAES_IV2 is trivial (all 0s or all 1s) when OPSTEP = 0x2</description>
                  <value>0xA</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0xB</name>
                  <description>Random in SAES_IV3 is trivial (all 0s or all 1s) when OPSTEP = 0x2</description>
                  <value>0xB</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0xC</name>
                  <description>When OPSTEP = 0x17 SAES GCM TAG comparison with CCB_REFTAG failed, or a register different from SAES_DOUT was read in the SAES.</description>
                  <value>0xC</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0xD</name>
                  <description>KEYSIZE  different  256 bits in SAES_CR when the SAES is enabled, and OPSTEP &gt; 0x0.</description>
                  <value>0xD</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0xE</name>
                  <description>CHMOD  different  GCM in SAES_CR when 0x1 less than OPSTEP less than 0x18, or the SAES is not enabled, or KEYVALID is cleared when GCMPH &gt; 0x0.</description>
                  <value>0xE</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0xF</name>
                  <description>KMOD different from wrapped key mode in SAES_CR when the SAES is enabled, and</description>
                  <value>0xF</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x10</name>
                  <description>KEYSEL  different  0x1 or 0x4 in SAES_CR when the SAES is enabled, KEYVALID is set, and OPSTEP=0x1.</description>
                  <value>0x10</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x11</name>
                  <description>GCMPH not correct (not incremented) in SAES_CR when OPSTEP &gt; 0x1.</description>
                  <value>0x11</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x12</name>
                  <description>MODE in SAES_CR does not match the expected value (selected by CCOP in CCB_CR) when OPSTEP &gt; 0x1.</description>
                  <value>0x12</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x13</name>
                  <description>BUSY = 1 in SAES_SR when OPSTEP= 0x18 or 0x19.</description>
                  <value>0x13</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x14</name>
                  <description>EN = 0 in PKA_CR when OPSTEP &gt; 0x2 (except 0x12).</description>
                  <value>0x14</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x15</name>
                  <description>INITOK = 0 in PKA_SR when OPSTEP &gt; 0x2 (except 0x12).</description>
                  <value>0x15</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x16</name>
                  <description>Authorized by local firewall, but unexpected AHB error detected when OPSTEP &gt; 0x0.</description>
                  <value>0x16</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x18</name>
                  <description>CCB_REFTAGRx registers are equal to 0 when OPSTEP &gt; 0x12.</description>
                  <value>0x18</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1A</name>
                  <description>Security or/and privilege protection inconsistent (see Section5: Global TrustZone controller (GTZC)) for the peripherals SAES, PKA, RNG, and CCB when OPSTEP &gt; 0x0.</description>
                  <value>0x1A</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1B</name>
                  <description>MODE in PKA_CR does not match the expected value (selected by CCOP in CCB_CR) when OPSTEP &gt; 0x0.</description>
                  <value>0x1B</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1C</name>
                  <description>OPSTEP end-step event not found at OPSTEP= 0x0 (SAES KEYVALID is set).</description>
                  <value>0x1C</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1D</name>
