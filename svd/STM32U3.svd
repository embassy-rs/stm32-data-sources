              <enumeratedValues>
                <enumeratedValue>
                  <name>B_0x0</name>
                  <description>Vless thansub&gt;REF+less than/sub&gt; pin is internally connected to the voltage reference buffer output.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>Vless thansub&gt;REF+less than/sub&gt; pin is high impedance.</description>
                  <value>0x1</value>
                </enumeratedValue>
