                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>Bit-reversed output format (RTYPE_OUT=0) or half-word reversal done by word (RTYPE_OUT=1)</description>
                  <value>0x1</value>
