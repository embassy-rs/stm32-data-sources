                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x0001</name>
                  <description>1 byte</description>
                  <value>0x0001</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x0002</name>
                  <description>2 bytes</description>
                  <value>0x0002</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0xFFFF</name>
                  <description>64 Kbytes-1 byte</description>
                  <value>0xFFFF</value>
                </enumeratedValue>
              </enumeratedValues>
