            </field>
          </fields>
        </register>
        <register>
          <name>GPDMA_C1FCR</name>
          <displayName>GPDMA_C1FCR</displayName>
          <description>GPDMA channel 1 flag clear register </description>
          <addressOffset>0xDC</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
