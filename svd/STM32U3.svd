                  <description>write to DA[7:0] and to IBIDEN in the I3C_DEVRx register is allowed</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>write to DA[7:0] and to IBIDEN is disabled/locked</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
