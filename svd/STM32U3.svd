</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>LPTIM1_CFGR2</name>
          <displayName>LPTIM1_CFGR2</displayName>
