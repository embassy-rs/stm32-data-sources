                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x2</name>
                  <description>Alarm B output enabled</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x3</name>
