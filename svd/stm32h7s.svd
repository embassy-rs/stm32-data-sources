              </field>
              <field>
                <name>CXPOS</name>
                <description>current X position 
These bits return the current X position.</description>
                <bitOffset>16</bitOffset>
                <bitWidth>16</bitWidth>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>LTDC_CDSR</name>
