              <field>
                <name>TAMP6E</name>
                <description>Tamper detection on TAMP_IN6 enable&lt;sup&gt;(1)&lt;/sup&gt;</description>
                <bitOffset>5</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
