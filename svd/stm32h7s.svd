	<peripheral derivedFrom="SAI1">
      <name>SAI2</name>
      <baseAddress>0x42005800</baseAddress>
      <interrupt>
        <name>SAI2_A</name>
        <description>SAI2 global interrupt A</description>
        <value>74</value>
