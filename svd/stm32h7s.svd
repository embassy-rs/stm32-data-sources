                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>Application can access to region x in privileged mode only.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
