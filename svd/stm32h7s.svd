                    <description>pll3_s_ck output enabled</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>PLL3DIVTEN</name>
                <description>PLL3 DIVT divider output enable
Set and reset by software to enable the pll3_t_ck output of the PLL3.
To save power, PLL1DIVTEN must be set to 0 when the pll3_t_ck is not used.</description>
                <bitOffset>31</bitOffset>
