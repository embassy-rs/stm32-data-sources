                    <description>BUSTURN phase duration = 0 fmc_ker_ck clock cycle added</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0xF</name>
                    <description>BUSTURN phase duration = 15 fmc_ker_ck clock cycles added (default value after reset)</description>
                    <value>0xF</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
