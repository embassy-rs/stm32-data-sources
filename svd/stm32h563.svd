                </enumeratedValues>
              </field>
              <field>
                <name>TAMP2AM</name>
                <description>Tamper 2 active mode</description>
                <bitOffset>1</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>B_0x0</name>
                    <description>Tamper 2 detection mode is passive.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
