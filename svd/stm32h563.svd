                    <description>11 bits.</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>NR</name>
                <description>Number of row address bits
These bits define the number of bits of a row address.</description>
                <bitOffset>2</bitOffset>
                <bitWidth>2</bitWidth>
