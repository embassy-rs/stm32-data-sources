                    <value>0x4</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x5</name>
                    <description>tim_ocref_clr5</description>
                    <value>0x5</value>
                  </enumeratedValue>
                  <enumeratedValue>
