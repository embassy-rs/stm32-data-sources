                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>TAMPPRIV</name>
                <description>Tamper privilege protection (excluding backup registers)
Note: Refer to  for details on the read protection.</description>
                <bitOffset>31</bitOffset>
