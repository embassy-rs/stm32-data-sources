                  <enumeratedValue>
                    <name>B_0x0</name>
                    <description>write buffer empty or full</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>write buffer waiting data to complete</description>
                    <value>0x1</value>
