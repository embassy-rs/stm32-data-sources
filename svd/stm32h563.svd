                <access>write-only</access>
              </field>
              <field>
                <name>CLR_OBKERR</name>
                <description>OBKERR flag clear bit.
Setting this bit to 1 resets to 0 OBKERR flag in FLASH_NSSR register.</description>
                <bitOffset>21</bitOffset>
                <bitWidth>1</bitWidth>
