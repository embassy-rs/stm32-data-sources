                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>Only secure data accesses are granted to sub-region A of region x.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
