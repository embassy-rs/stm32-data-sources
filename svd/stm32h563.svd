                    <description>8 MTL Tx</description>
                    <value>0x7</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>RXCHCNT</name>
                <description>Number of DMA Receive Channels
This field indicates the number of DMA Receive channels:
..</description>
                <bitOffset>12</bitOffset>
                <bitWidth>4</bitWidth>
                <access>read-only</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>B_0x0</name>
                    <description>1 DMA Rx Channel</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>2 DMA Rx Channels</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
