This bit is set to 1 when 10/100 Mbps is selected as operating mode.</description>
                <bitOffset>0</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-only</access>
              </field>
              <field>
                <name>GMIISEL</name>
