              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>B_0x0</name>
                  <description>DU[3:0] represents the date units</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>DU[3:0] represents the week day. DT[1:0] is don't care.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
