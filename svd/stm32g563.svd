                  <description>No mode error</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>The value written in MODE[5:0] of PKA_CR registers is different from the expected value corresponding to the CCOP mode selected in the CCB peripheral. Refer to Section30.4.7 for details.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
