                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>Derived hardware unique key (DHUK)</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x2</name>
                  <description>Boot hardware key (BHK)</description>
                  <value>0x2</value>
