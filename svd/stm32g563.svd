              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>B_0x0</name>
                  <description>Bit n of the data received in automatic status-polling mode is masked and its value is not considered in the matching logic.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>Bit n of the data received in automatic status-polling mode is unmasked and its value is considered in the matching logic.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
