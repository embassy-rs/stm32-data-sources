                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>Only ECDSA verification (MODE[5:0] = 0x26) is supported by the PKA.</description>
                  <value>0x1</value>
                </enumeratedValue>
