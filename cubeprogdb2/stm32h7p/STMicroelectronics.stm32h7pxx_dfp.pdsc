            <descriptor schemaType="DMA" path="Descriptors/peripherals/D47B_DMA.json" schemaVersion="1.2.0" version="3.0.0"/>
            <descriptor schemaType="NVIC" path="Descriptors/peripherals/D47B_NVIC.json" schemaVersion="1.1.0" version="7.0.0"/>
            <descriptor schemaType="EXTI" path="Descriptors/peripherals/D47B_EXTI.json" schemaVersion="1.2.1" version="6.0.0"/>
            <descriptor schemaType="middlewares" path="Descriptors/middlewares/D47B_middlewares.json" schemaVersion="1.1.0" version="1.1.0"/>
            <descriptor schemaType="limitations" path="Descriptors/limitations/D47B_limitations.json" schemaVersion="1.1.0" version="1.0.0"/>
            <descriptor schemaType="peripheral-configuration-mapping" path="Descriptors/peripheral_configuration_mapping.json" schemaVersion="1.0.0" version="1.0.0"/>
            <descriptor schemaType="utilities" path="Descriptors/utilities/D47B_utilities.json" schemaVersion="1.1.0" version="2.0.0"/>
          </descriptors>
        </stm32:device>
      </environment>
      <environment name="STM32CubeProgrammer">
        <idcode address="0x4E004000" id="0x47B" ap="1"/>
      </environment>
