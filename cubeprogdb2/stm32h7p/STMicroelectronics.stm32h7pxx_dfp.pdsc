  <devices>
    <family Dfamily="STM32H7P Series" Dvendor="STMicroelectronics:13">
      <processor Dcore="Cortex-M7" DcoreVersion="r1p2" Dfpu="DP_FPU" Dmpu="MPU" Ddsp="DSP" Dtz="NO_TZ" Dendian="Little-endian" Dclock="550000000"/>
      <memory name="SRAM" access="rwx" start="0x20000000" size="0x20000" uninit="true" default="true"/>
      <memory name="HSP_DATA_BRAM" access="rwx" start="0x30018000" size="0x4000" uninit="true"/>
      <description>The STM32H7P4/H7P5 lines contain the Arm Cortex-M7 core (with double-precision floating point unit) running up to 550 MHz</description>
      <feature type="Memory" name="RAM" n="327680"/>
      <feature type="VCC" name="Operating Voltage" n="1.62" m="3.6"/>
      <environment name="STM32Cube">
        <stm32:device>
