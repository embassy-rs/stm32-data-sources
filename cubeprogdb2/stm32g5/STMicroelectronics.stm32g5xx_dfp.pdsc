  <vendor>STMicroelectronics</vendor>
  <name>stm32g5xx_dfp</name>
  <description>STMicroelectronics STM32G5 Series Device Family Pack</description>
  <ECCN>
    <ECCN-EU>NEC</ECCN-EU>
    <ECCN-US>EAR99</ECCN-US>
  </ECCN>
  <environments>
    <environment name="STM32Cube">
      <stm32:pack type="DFP" friendlyName="stm32g5xx_dfp" shortDesc="STM32G5 Series Device Support">
        <relocation-info parent="" layer="" element=""/>
        <compatibility>
          <release version="2.0.0">
            <applicable-schema schemaType="clock" schemaVersion="1.0.0"/>
            <applicable-schema schemaType="peripherals" schemaVersion="1.8.0"/>
            <applicable-schema schemaType="DMA" schemaVersion="1.2.0"/>
            <applicable-schema schemaType="NVIC" schemaVersion="1.1.0"/>
            <applicable-schema schemaType="EXTI" schemaVersion="1.2.1"/>
            <applicable-schema schemaType="middlewares" schemaVersion="1.1.0"/>
            <applicable-schema schemaType="limitations" schemaVersion="1.1.0"/>
            <applicable-schema schemaType="pinout" schemaVersion="1.0.0"/>
            <applicable-schema schemaType="peripheral-configuration-mapping" schemaVersion="1.0.0"/>
            <applicable-schema schemaType="utilities" schemaVersion="1.1.0"/>
          </release>
        </compatibility>
      </stm32:pack>
    </environment>
  </environments>
  <url>https://developer.st.com/st-pack-server/api/v1/pack/</url>
  <repository type="git">https://github.com/STMicroelectronics/stm32g5xx-dfp</repository>
  <license>LICENSE.md</license>
  <releases>
    <release version="2.0.0" date="2026-09-22">
      First Official release of STM32G5xx DFP
      =======================================
        Supported Devices
          - STM32G534xx, STM32G544xx devices
          - STM32G553xx, STM32G554xx, STM32G563xx and STM32G564xx devices

      Contents
      ========
        CMSIS-Core Device Files
          - Device C Startup files
          - Device system configuration files
          - Device header and System View Description (SVD) files, supporting
            - System: CRS, DBGMCU, DCACHE, DLYB, DMA, ICACHE, IWDG, PWR, RCC, RTC, SBS, WWDG
            - Analog: ADC, COMP, DAC, DTS, OPAMP, POSENC, VREFBUF
            - Timers: HRTIM, LPTIM, TIM
            - Logic Array: PLAY
            - Connectivity: FDCAN, I2C, I3C, SPI, UCPD, USART, USB
            - Security: AES, CCB, GTZC, HASH, OTFDEC, PKA, RNG, TAMP
            - Computing: CORDIC, CRC, FMAC
            - I/O: EXTI, GPIO
            - Memory: FLASH, RAMCFG, XSPI
          - Device linker configuration template files
        Integrated Development Environment and Tools Support Files
          - Flash Programming Algorithms for erasing and downloading code into on-chip Flash
          - System View Description (SVD) files
          - Device descriptor files for bus, clock, peripherals and pinout

      Supported Integrated Development Environment and Compilers
      ==========================================================
        - IAR Embedded Workbench for ARM (EWARM) toolchain V9.60.3 + ST-LINK (Patch available in `IDEs_patches/EWARM`)
        - MDK-ARM Keil uVision V5.42
        - STM32CubeIDE for Visual Studio Code (GCC13 compiler)

      Known Limitations
      =================
        - UCPD trim fields `TRIM_CC1_RP3A0` and `TRIM_CC2_RP3A0` correspond to the reference manual fields
          `TRIM_CC1_RP` and `TRIM_CC2_RP`, respectively.
        - The following device variants (STM32G563xB, STM32G563xC, STM32G554xB, STM32G554xC) are not supported in this release.

      Dependencies
      ============
        - CMSIS Core V6.3.0
    </release>
  </releases>
  <changelogs>
    <changelog id="Release Notes" name="Release_Notes.html"/>
  </changelogs>
